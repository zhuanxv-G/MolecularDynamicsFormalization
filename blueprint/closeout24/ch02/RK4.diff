 def bp_rk4 {n : ℕ} (f : Q n → Q n) (h : ℝ) (z : Q n) : Q n :=
   let k₁ := f z
   let k₂ := f (z + (h/2) • k₁)
   let k₃ := f (z + (h/2) • k₂)
   let k₄ := f (z + h • k₃)
   z + (h/6) • (k₁ + (2 : ℝ) • k₂ + (2 : ℝ) • k₃ + k₄)
+
+theorem bp_rk4_eq_rk4 {n : ℕ} (f : Q n → Q n) (h : ℝ) (z : Q n) :
+    bp_rk4 f h z = MolecularDynamics.Chapter02Review.rk4 f h z := rfl
+
 
