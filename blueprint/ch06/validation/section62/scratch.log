    -(γ * β⁻¹) *
      ∑ i,
        MolecularDynamics.textbookLangevinCanonicalCoordinateAdjointTestExpression U β (Sum.inr i)
          (MolecularDynamics.textbookLangevinPeriodicDirectionalDerivative G (0, Pi.single i 1)) x
