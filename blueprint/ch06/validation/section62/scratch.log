  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (hβ : 0 < β) {Ω : Type u_1} [MeasurableSpace Ω]
  (B : NNReal → Ω → Fin Nc → ℝ) (P : MeasureTheory.Measure Ω) (hB : MolecularDynamics.textbookIsWienerVector B P) :
  ∃ M,
    0 ≤ M ∧
      ∀ (x : Fin Nc → ℝ) (t : ℝ),
        0 ≤ t →
