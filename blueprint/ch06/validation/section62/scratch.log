  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (hβ : 0 < β) {Ω : Type u_1} [MeasurableSpace Ω]
  (B : NNReal → Ω → Fin Nc → ℝ) (P : MeasureTheory.Measure Ω) (hB : MolecularDynamics.textbookIsWienerVector B P)
  (f : (Fin Nc → ℝ) → ℝ) (x : Fin Nc → ℝ) (t : ℝ) (ht : 0 ≤ t) :
  MeasureTheory.Integrable
    (fun sample =>
      ∑ i,
        ∑ j,
          MolecularDynamics.textbookConfigurationPartial (MolecularDynamics.textbookConfigurationPartial f j) i x *
            ((MolecularDynamics.textbookBrownianGlobalRandomConfiguration m hm U hU hPU β hβ x B t sample - x) i *
              (MolecularDynamics.textbookBrownianGlobalRandomConfiguration m hm U hU hPU β hβ x B t sample - x) j))
    P
MolecularDynamics.textbookBrownianGlobalRandomConfiguration_observable_expectation_Taylor.{u_1} {Nc : ℕ}
  (m : Fin Nc → ℝ) (hm : ∀ (i : Fin Nc), 0 < m i) (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (hβ : 0 < β) {Ω : Type u_1} [MeasurableSpace Ω]
  (B : NNReal → Ω → Fin Nc → ℝ) (P : MeasureTheory.Measure Ω) (hB : MolecularDynamics.textbookIsWienerVector B P)
  (f : (Fin Nc → ℝ) → ℝ) (hf : ContDiff ℝ (↑⊤) f) (hpf : MolecularDynamics.textbookUnitPeriodicPotential f)
  (x : Fin Nc → ℝ) (t : ℝ) (ht : 0 ≤ t) :
  ∫ (sample : Ω), f (MolecularDynamics.textbookBrownianGlobalRandomConfiguration m hm U hU hPU β hβ x B t sample) ∂P -
      f x =
    (fderiv ℝ f x)
          (∫ (sample : Ω),
            MolecularDynamics.textbookBrownianGlobalRandomConfiguration m hm U hU hPU β hβ x B t sample - x ∂P) +
        2⁻¹ *
          ∑ i,
            ∑ j,
              MolecularDynamics.textbookConfigurationPartial (MolecularDynamics.textbookConfigurationPartial f j) i x *
                ∫ (sample : Ω),
                  (MolecularDynamics.textbookBrownianGlobalRandomConfiguration m hm U hU hPU β hβ x B t sample - x) i *
                    (MolecularDynamics.textbookBrownianGlobalRandomConfiguration m hm U hU hPU β hβ x B t sample - x)
                      j ∂P +
      ∫ (sample : Ω),
        MolecularDynamics.textbookBrownianGlobalObservableTaylorRemainder m hm U hU hPU β hβ B f x t sample ∂P
