  (hβ : β ≠ 0) (f g : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U) (hf : ContDiff ℝ (↑⊤) f) (hg : ContDiff ℝ (↑⊤) g)
  (q : Fin Nc → ℝ) :
  ∑ i, MolecularDynamics.textbookConfigurationPartial (MolecularDynamics.textbookBrownianWeightedFlux m U β f g i) i q =
    (MolecularDynamics.textbookConfigurationGradientPair m f g q +
        β * f q * MolecularDynamics.textbookBrownianGenerator m U β g q) *
      MolecularDynamics.textbookConfigurationGibbsWeight U β q
