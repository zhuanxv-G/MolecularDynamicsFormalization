MolecularDynamics.textbookWienerSelfItoIntegral_exists.{u_1} {Ω : Type u_1} [MeasurableSpace Ω]
  {P : MeasureTheory.Measure Ω} {W : NNReal → Ω → ℝ} (hW : ProbabilityTheory.IsPreBrownianReal W P) (T : NNReal) :
  ∃ Y,
    MeasureTheory.MemLp Y 2 P ∧
      Filter.Tendsto (fun K => ∫ (ω : Ω), (MolecularDynamics.textbookWienerSelfItoSum W T K ω - Y ω) ^ 2 ∂P)
