  (hm : ∀ (i : Fin Nc), 0 < m i) (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (hβ : 0 < β)
  (x : ↥(MolecularDynamics.textbookBrownianGibbsClosedOperator m U hU hPU β).domain)
  (hx : ↑(MolecularDynamics.textbookBrownianGibbsClosedOperator m U hU hPU β) x = 0) :
  ↑x =
    inner ℝ
        ((MolecularDynamics.textbookPeriodicSmoothEmbedding U hU hPU β)
          (MolecularDynamics.textbookPeriodicSmoothConstant Nc 1))
        ↑x •
      (MolecularDynamics.textbookPeriodicSmoothEmbedding U hU hPU β)
        (MolecularDynamics.textbookPeriodicSmoothConstant Nc 1)
MolecularDynamics.textbookBrownianGibbsClosedOperator_eigenvalue_orthogonal {Nc : ℕ} (m : Fin Nc → ℝ)
  (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U) (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ)
  (hβ : β ≠ 0) (x : ↥(MolecularDynamics.textbookBrownianGibbsClosedOperator m U hU hPU β).domain) (ℓ : ℝ) (hℓ : ℓ ≠ 0)
  (heig : ↑(MolecularDynamics.textbookBrownianGibbsClosedOperator m U hU hPU β) x = ℓ • ↑x) :
  inner ℝ
      ((MolecularDynamics.textbookPeriodicSmoothEmbedding U hU hPU β)
        (MolecularDynamics.textbookPeriodicSmoothConstant Nc 1))
      ↑x =
    0
MolecularDynamics.textbookBrownianGibbsClosedOperator_real_eigenvalue_bound {Nc : ℕ} (m : Fin Nc → ℝ)
  (hm : ∀ (i : Fin Nc), 0 < m i) (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (hβ : 0 < β)
  (x : ↥(MolecularDynamics.textbookBrownianGibbsClosedOperator m U hU hPU β).domain) (hx : ↑x ≠ 0) (ℓ : ℝ) (hℓ : ℓ ≠ 0)
  (heig : ↑(MolecularDynamics.textbookBrownianGibbsClosedOperator m U hU hPU β) x = ℓ • ↑x) :
  ℓ ≤ -MolecularDynamics.textbookBrownianGibbsCoercivityRate m U hU hPU β
MolecularDynamics.textbookMassFourierFrequency {Nc : ℕ} (m : Fin Nc → ℝ) (β : ℝ) (n : Fin Nc → ℤ) : ℝ
MolecularDynamics.textbookMassFourierFrequency_zero {Nc : ℕ} (m : Fin Nc → ℝ) (β : ℝ) :
  MolecularDynamics.textbookMassFourierFrequency m β 0 = 0
MolecularDynamics.textbookMassFourierFrequency_unit {Nc : ℕ} (n : Fin Nc → ℤ) :
  MolecularDynamics.textbookMassFourierFrequency (fun x => 1) 1 n = MolecularDynamics.textbookFourierLaplaceFrequency n
MolecularDynamics.textbookMassFourierFrequency_neg {Nc : ℕ} (m : Fin Nc → ℝ) (β : ℝ) (n : Fin Nc → ℤ) :
  MolecularDynamics.textbookMassFourierFrequency m β (-n) = MolecularDynamics.textbookMassFourierFrequency m β n
MolecularDynamics.textbookMassFourierFrequency_nonneg {Nc : ℕ} (m : Fin Nc → ℝ) (hm : ∀ (i : Fin Nc), 0 < m i) (β : ℝ)
  (hβ : 0 < β) (n : Fin Nc → ℤ) : 0 ≤ MolecularDynamics.textbookMassFourierFrequency m β n
MolecularDynamics.textbookConfigurationMassScale_inv_le {Nc : ℕ} (m : Fin Nc → ℝ) (hm : ∀ (i : Fin Nc), 0 < m i)
  (i : Fin Nc) : (MolecularDynamics.textbookConfigurationMassScale m)⁻¹ ≤ (m i)⁻¹
MolecularDynamics.textbookMassFourierFrequency_coercive {Nc : ℕ} (m : Fin Nc → ℝ) (hm : ∀ (i : Fin Nc), 0 < m i) (β : ℝ)
  (hβ : 0 < β) (n : Fin Nc → ℤ) :
  β⁻¹ * (4 * Real.pi ^ 2) * (MolecularDynamics.textbookConfigurationMassScale m)⁻¹ * ∑ i, ↑(n i) ^ 2 ≤
    MolecularDynamics.textbookMassFourierFrequency m β n
MolecularDynamics.textbookMassFourierFrequency_lower {Nc : ℕ} (m : Fin Nc → ℝ) (hm : ∀ (i : Fin Nc), 0 < m i) (β : ℝ)
  (hβ : 0 < β) (n : Fin Nc → ℤ) (hn : n ≠ 0) :
  β⁻¹ * (4 * Real.pi ^ 2) * (MolecularDynamics.textbookConfigurationMassScale m)⁻¹ ≤
    MolecularDynamics.textbookMassFourierFrequency m β n
MolecularDynamics.textbookMassFourierFrequency_pos {Nc : ℕ} (m : Fin Nc → ℝ) (hm : ∀ (i : Fin Nc), 0 < m i) (β : ℝ)
  (hβ : 0 < β) (n : Fin Nc → ℤ) (hn : n ≠ 0) : 0 < MolecularDynamics.textbookMassFourierFrequency m β n
MolecularDynamics.textbookMassFourierFrequency_eq_zero_iff {Nc : ℕ} (m : Fin Nc → ℝ) (hm : ∀ (i : Fin Nc), 0 < m i)
  (β : ℝ) (hβ : 0 < β) (n : Fin Nc → ℤ) : MolecularDynamics.textbookMassFourierFrequency m β n = 0 ↔ n = 0
MolecularDynamics.textbookBrownianGenerator_mass_flat {Nc : ℕ} (m : Fin Nc → ℝ) (β : ℝ) (f : (Fin Nc → ℝ) → ℝ)
  (q : Fin Nc → ℝ) :
  MolecularDynamics.textbookBrownianGenerator m (fun x => 0) β f q =
    ∑ i,
      (m i)⁻¹ * β⁻¹ *
        MolecularDynamics.textbookConfigurationPartial (MolecularDynamics.textbookConfigurationPartial f i) i q
MolecularDynamics.textbookFourierCosineLift_mass_generator {Nc : ℕ} (m : Fin Nc → ℝ) (β : ℝ) (n : Fin Nc → ℤ)
  (q : Fin Nc → ℝ) :
  MolecularDynamics.textbookBrownianGenerator m (fun x => 0) β (MolecularDynamics.textbookFourierCosineLift n) q =
    -MolecularDynamics.textbookMassFourierFrequency m β n * MolecularDynamics.textbookFourierCosineLift n q
MolecularDynamics.textbookFourierSineLift_mass_generator {Nc : ℕ} (m : Fin Nc → ℝ) (β : ℝ) (n : Fin Nc → ℤ)
  (q : Fin Nc → ℝ) :
  MolecularDynamics.textbookBrownianGenerator m (fun x => 0) β (MolecularDynamics.textbookFourierSineLift n) q =
    -MolecularDynamics.textbookMassFourierFrequency m β n * MolecularDynamics.textbookFourierSineLift n q
MolecularDynamics.textbookHaarMassLaplace_dirichlet {Nc : ℕ} (m : Fin Nc → ℝ) (β : ℝ) (hβ : β ≠ 0)
  (f g : (Fin Nc → ℝ) → ℝ) (hf : ContDiff ℝ (↑⊤) f) (hg : ContDiff ℝ (↑⊤) g)
  (hPf : MolecularDynamics.textbookUnitPeriodicPotential f) (hPg : MolecularDynamics.textbookUnitPeriodicPotential g) :
  ∫ (Q : UnitAddTorus (Fin Nc)),
      MolecularDynamics.textbookConfigurationTorusObservable f Q *
        MolecularDynamics.textbookConfigurationTorusObservable
          (MolecularDynamics.textbookBrownianGenerator m (fun x => 0) β g) Q =
    -β⁻¹ *
      ∫ (Q : UnitAddTorus (Fin Nc)),
        MolecularDynamics.textbookConfigurationTorusObservable
          (MolecularDynamics.textbookConfigurationGradientPair m f g) Q
MolecularDynamics.textbookHaarMassLaplace_symmetric {Nc : ℕ} (m : Fin Nc → ℝ) (β : ℝ) (hβ : β ≠ 0)
  (f g : (Fin Nc → ℝ) → ℝ) (hf : ContDiff ℝ (↑⊤) f) (hg : ContDiff ℝ (↑⊤) g)
  (hPf : MolecularDynamics.textbookUnitPeriodicPotential f) (hPg : MolecularDynamics.textbookUnitPeriodicPotential g) :
  ∫ (Q : UnitAddTorus (Fin Nc)),
      MolecularDynamics.textbookConfigurationTorusObservable f Q *
        MolecularDynamics.textbookConfigurationTorusObservable
          (MolecularDynamics.textbookBrownianGenerator m (fun x => 0) β g) Q =
    ∫ (Q : UnitAddTorus (Fin Nc)),
      MolecularDynamics.textbookConfigurationTorusObservable
          (MolecularDynamics.textbookBrownianGenerator m (fun x => 0) β f) Q *
        MolecularDynamics.textbookConfigurationTorusObservable g Q
MolecularDynamics.textbookHaarMassLaplace_cosine_pairing {Nc : ℕ} (m : Fin Nc → ℝ) (β : ℝ) (hβ : β ≠ 0)
  (f : (Fin Nc → ℝ) → ℝ) (hf : ContDiff ℝ (↑⊤) f) (hPf : MolecularDynamics.textbookUnitPeriodicPotential f)
  (n : Fin Nc → ℤ) :
  ∫ (Q : UnitAddTorus (Fin Nc)),
      MolecularDynamics.textbookConfigurationTorusObservable (MolecularDynamics.textbookFourierCosineLift n) Q *
        MolecularDynamics.textbookConfigurationTorusObservable
          (MolecularDynamics.textbookBrownianGenerator m (fun x => 0) β f) Q =
    -MolecularDynamics.textbookMassFourierFrequency m β n *
      ∫ (Q : UnitAddTorus (Fin Nc)),
        MolecularDynamics.textbookConfigurationTorusObservable (MolecularDynamics.textbookFourierCosineLift n) Q *
          MolecularDynamics.textbookConfigurationTorusObservable f Q
MolecularDynamics.textbookHaarMassLaplace_sine_pairing {Nc : ℕ} (m : Fin Nc → ℝ) (β : ℝ) (hβ : β ≠ 0)
  (f : (Fin Nc → ℝ) → ℝ) (hf : ContDiff ℝ (↑⊤) f) (hPf : MolecularDynamics.textbookUnitPeriodicPotential f)
  (n : Fin Nc → ℤ) :
  ∫ (Q : UnitAddTorus (Fin Nc)),
      MolecularDynamics.textbookConfigurationTorusObservable (MolecularDynamics.textbookFourierSineLift n) Q *
        MolecularDynamics.textbookConfigurationTorusObservable
          (MolecularDynamics.textbookBrownianGenerator m (fun x => 0) β f) Q =
    -MolecularDynamics.textbookMassFourierFrequency m β n *
      ∫ (Q : UnitAddTorus (Fin Nc)),
        MolecularDynamics.textbookConfigurationTorusObservable (MolecularDynamics.textbookFourierSineLift n) Q *
          MolecularDynamics.textbookConfigurationTorusObservable f Q
MolecularDynamics.textbookHaarMassLaplace_fourierCoeff {Nc : ℕ} (m : Fin Nc → ℝ) (β : ℝ) (hβ : β ≠ 0)
  (f : (Fin Nc → ℝ) → ℝ) (hf : ContDiff ℝ (↑⊤) f) (hPf : MolecularDynamics.textbookUnitPeriodicPotential f)
  (n : Fin Nc → ℤ) :
  UnitAddTorus.mFourierCoeff
      (fun Q =>
        ↑(MolecularDynamics.textbookConfigurationTorusObservable
            (MolecularDynamics.textbookBrownianGenerator m (fun x => 0) β f) Q))
      n =
    -↑(MolecularDynamics.textbookMassFourierFrequency m β n) *
      UnitAddTorus.mFourierCoeff (fun Q => ↑(MolecularDynamics.textbookConfigurationTorusObservable f Q)) n
MolecularDynamics.textbookTorusHaarMassGradientEnergy {Nc : ℕ} (m : Fin Nc → ℝ) (β : ℝ) (f : (Fin Nc → ℝ) → ℝ) : ℝ
MolecularDynamics.textbookTorusHaarMassGradientEnergy_eq_sum {Nc : ℕ} (m : Fin Nc → ℝ) (β : ℝ) (f : (Fin Nc → ℝ) → ℝ) :
  MolecularDynamics.textbookTorusHaarMassGradientEnergy m β f =
    β⁻¹ *
      ∫ (Q : UnitAddTorus (Fin Nc)),
        ∑ i,
          (m i)⁻¹ *
            MolecularDynamics.textbookConfigurationPartial f i
                (MolecularDynamics.textbookConfigurationTorusRepresentative Q) ^
              2
MolecularDynamics.textbookTorusHaarMassGradientEnergy_nonneg {Nc : ℕ} (m : Fin Nc → ℝ) (hm : ∀ (i : Fin Nc), 0 < m i)
  (β : ℝ) (hβ : 0 < β) (f : (Fin Nc → ℝ) → ℝ) : 0 ≤ MolecularDynamics.textbookTorusHaarMassGradientEnergy m β f
MolecularDynamics.textbookTorusHaarMassFourier_energy_hasSum {Nc : ℕ} (m : Fin Nc → ℝ) (β : ℝ) (hβ : β ≠ 0)
  (f : (Fin Nc → ℝ) → ℝ) (hf : ContDiff ℝ (↑⊤) f) (hPf : MolecularDynamics.textbookUnitPeriodicPotential f) :
  HasSum
    (fun n =>
      MolecularDynamics.textbookMassFourierFrequency m β n *
        ‖UnitAddTorus.mFourierCoeff (fun Q => ↑(MolecularDynamics.textbookConfigurationTorusObservable f Q)) n‖ ^ 2)
    (MolecularDynamics.textbookTorusHaarMassGradientEnergy m β f)
MolecularDynamics.textbookTorusHaarMassFourier_generator_sq_hasSum {Nc : ℕ} (m : Fin Nc → ℝ) (β : ℝ) (hβ : β ≠ 0)
  (f : (Fin Nc → ℝ) → ℝ) (hf : ContDiff ℝ (↑⊤) f) (hPf : MolecularDynamics.textbookUnitPeriodicPotential f) :
  HasSum
    (fun n =>
      MolecularDynamics.textbookMassFourierFrequency m β n ^ 2 *
        ‖UnitAddTorus.mFourierCoeff (fun Q => ↑(MolecularDynamics.textbookConfigurationTorusObservable f Q)) n‖ ^ 2)
    (∫ (Q : UnitAddTorus (Fin Nc)),
      MolecularDynamics.textbookConfigurationTorusObservable
          (MolecularDynamics.textbookBrownianGenerator m (fun x => 0) β f) Q ^
        2)
MolecularDynamics.textbookMassFourierFrequency_finite_sublevel {Nc : ℕ} (m : Fin Nc → ℝ) (hm : ∀ (i : Fin Nc), 0 < m i)
  (β : ℝ) (hβ : 0 < β) (R : ℝ) : {n | MolecularDynamics.textbookMassFourierFrequency m β n ≤ R}.Finite
MolecularDynamics.textbookMassFourierFrequency_tendsto {Nc : ℕ} (m : Fin Nc → ℝ) (hm : ∀ (i : Fin Nc), 0 < m i) (β : ℝ)
  (hβ : 0 < β) : Filter.Tendsto (MolecularDynamics.textbookMassFourierFrequency m β) Filter.cofinite Filter.atTop
MolecularDynamics.textbookMassFourierFrequency_resolvent_decay {Nc : ℕ} (m : Fin Nc → ℝ) (hm : ∀ (i : Fin Nc), 0 < m i)
  (β : ℝ) (hβ : 0 < β) :
  Filter.Tendsto (fun n => (1 + MolecularDynamics.textbookMassFourierFrequency m β n)⁻¹) Filter.cofinite (nhds 0)
MolecularDynamics.textbookConfigurationPartial_mul {Nc : ℕ} (f g : (Fin Nc → ℝ) → ℝ) (hf : ContDiff ℝ (↑⊤) f)
  (hg : ContDiff ℝ (↑⊤) g) (i : Fin Nc) (q : Fin Nc → ℝ) :
  MolecularDynamics.textbookConfigurationPartial (fun x => f x * g x) i q =
    MolecularDynamics.textbookConfigurationPartial f i q * g q +
      f q * MolecularDynamics.textbookConfigurationPartial g i q
MolecularDynamics.textbookConfigurationPartial_second_mul {Nc : ℕ} (f g : (Fin Nc → ℝ) → ℝ) (hf : ContDiff ℝ (↑⊤) f)
  (hg : ContDiff ℝ (↑⊤) g) (i : Fin Nc) (q : Fin Nc → ℝ) :
  MolecularDynamics.textbookConfigurationPartial (MolecularDynamics.textbookConfigurationPartial (fun x => f x * g x) i)
      i q =
    MolecularDynamics.textbookConfigurationPartial (MolecularDynamics.textbookConfigurationPartial f i) i q * g q +
        2 * MolecularDynamics.textbookConfigurationPartial f i q *
          MolecularDynamics.textbookConfigurationPartial g i q +
      f q * MolecularDynamics.textbookConfigurationPartial (MolecularDynamics.textbookConfigurationPartial g i) i q
MolecularDynamics.textbookConfigurationGibbsWeight_second_partial {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ)
  (hU : ContDiff ℝ (↑⊤) U) (θ : ℝ) (i : Fin Nc) (q : Fin Nc → ℝ) :
  MolecularDynamics.textbookConfigurationPartial
      (MolecularDynamics.textbookConfigurationPartial (MolecularDynamics.textbookConfigurationGibbsWeight U θ) i) i q =
    (-θ * MolecularDynamics.textbookConfigurationPartial (MolecularDynamics.textbookConfigurationPartial U i) i q +
        θ ^ 2 * MolecularDynamics.textbookConfigurationPartial U i q ^ 2) *
      MolecularDynamics.textbookConfigurationGibbsWeight U θ q
MolecularDynamics.textbookGibbsGroundStateFactor {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (β : ℝ) : (Fin Nc → ℝ) → ℝ
MolecularDynamics.textbookGibbsGroundStateInverse {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (β : ℝ) : (Fin Nc → ℝ) → ℝ
MolecularDynamics.textbookGibbsGroundStateFactor_contDiff {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (β : ℝ) : ContDiff ℝ (↑⊤) (MolecularDynamics.textbookGibbsGroundStateFactor U β)
MolecularDynamics.textbookGibbsGroundStateInverse_contDiff {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (β : ℝ) : ContDiff ℝ (↑⊤) (MolecularDynamics.textbookGibbsGroundStateInverse U β)
MolecularDynamics.textbookGibbsGroundStateFactor_periodic {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) :
  MolecularDynamics.textbookUnitPeriodicPotential (MolecularDynamics.textbookGibbsGroundStateFactor U β)
MolecularDynamics.textbookGibbsGroundStateInverse_periodic {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) :
  MolecularDynamics.textbookUnitPeriodicPotential (MolecularDynamics.textbookGibbsGroundStateInverse U β)
MolecularDynamics.textbookGibbsGroundStateFactor_pos {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (β : ℝ) (q : Fin Nc → ℝ) :
  0 < MolecularDynamics.textbookGibbsGroundStateFactor U β q
MolecularDynamics.textbookGibbsGroundStateFactor_mul_inverse {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (β : ℝ) (q : Fin Nc → ℝ) :
  MolecularDynamics.textbookGibbsGroundStateFactor U β q * MolecularDynamics.textbookGibbsGroundStateInverse U β q = 1
MolecularDynamics.textbookGibbsGroundStateFactor_sq {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (β : ℝ) (q : Fin Nc → ℝ) :
  MolecularDynamics.textbookGibbsGroundStateFactor U β q ^ 2 = MolecularDynamics.textbookConfigurationGibbsWeight U β q
MolecularDynamics.textbookBrownianGroundStatePotential {Nc : ℕ} (m : Fin Nc → ℝ) (U : (Fin Nc → ℝ) → ℝ) (β : ℝ)
  (q : Fin Nc → ℝ) : ℝ
MolecularDynamics.textbookBrownianGroundStatePotential_contDiff {Nc : ℕ} (m : Fin Nc → ℝ) (U : (Fin Nc → ℝ) → ℝ)
  (hU : ContDiff ℝ (↑⊤) U) (β : ℝ) : ContDiff ℝ (↑⊤) (MolecularDynamics.textbookBrownianGroundStatePotential m U β)
MolecularDynamics.textbookBrownianGroundStatePotential_periodic {Nc : ℕ} (m : Fin Nc → ℝ) (U : (Fin Nc → ℝ) → ℝ)
  (hU : ContDiff ℝ (↑⊤) U) (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) :
  MolecularDynamics.textbookUnitPeriodicPotential (MolecularDynamics.textbookBrownianGroundStatePotential m U β)
MolecularDynamics.textbookBrownianTorusGroundStatePotential {Nc : ℕ} (m : Fin Nc → ℝ) (U : (Fin Nc → ℝ) → ℝ)
  (hU : ContDiff ℝ (↑⊤) U) (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) :
  C(UnitAddTorus (Fin Nc), ℝ)
MolecularDynamics.textbookBrownianTorusGroundStatePotential_lift {Nc : ℕ} (m : Fin Nc → ℝ) (U : (Fin Nc → ℝ) → ℝ)
  (hU : ContDiff ℝ (↑⊤) U) (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (q : Fin Nc → ℝ) :
  (MolecularDynamics.textbookBrownianTorusGroundStatePotential m U hU hPU β)
      (MolecularDynamics.textbookConfigurationTorusProjection q) =
    MolecularDynamics.textbookBrownianGroundStatePotential m U β q
MolecularDynamics.textbookBrownianGroundStatePotential_abs_le_norm {Nc : ℕ} (m : Fin Nc → ℝ) (U : (Fin Nc → ℝ) → ℝ)
  (hU : ContDiff ℝ (↑⊤) U) (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (q : Fin Nc → ℝ) :
  |MolecularDynamics.textbookBrownianGroundStatePotential m U β q| ≤
    ‖MolecularDynamics.textbookBrownianTorusGroundStatePotential m U hU hPU β‖
MolecularDynamics.textbookBrownianGenerator_groundState_inverse {Nc : ℕ} (m : Fin Nc → ℝ) (U : (Fin Nc → ℝ) → ℝ)
  (hU : ContDiff ℝ (↑⊤) U) (β : ℝ) (hβ : β ≠ 0) (f : (Fin Nc → ℝ) → ℝ) (hf : ContDiff ℝ (↑⊤) f) (q : Fin Nc → ℝ) :
  MolecularDynamics.textbookBrownianGenerator m U β
      (fun x => MolecularDynamics.textbookGibbsGroundStateInverse U β x * f x) q =
    MolecularDynamics.textbookGibbsGroundStateInverse U β q *
      (MolecularDynamics.textbookBrownianGenerator m (fun x => 0) β f q +
        MolecularDynamics.textbookBrownianGroundStatePotential m U β q * f q)
MolecularDynamics.textbookBrownianGenerator_groundState_conjugation {Nc : ℕ} (m : Fin Nc → ℝ) (U : (Fin Nc → ℝ) → ℝ)
  (hU : ContDiff ℝ (↑⊤) U) (β : ℝ) (hβ : β ≠ 0) (f : (Fin Nc → ℝ) → ℝ) (hf : ContDiff ℝ (↑⊤) f) (q : Fin Nc → ℝ) :
  MolecularDynamics.textbookGibbsGroundStateFactor U β q *
      MolecularDynamics.textbookBrownianGenerator m U β
        (fun x => MolecularDynamics.textbookGibbsGroundStateInverse U β x * f x) q =
    MolecularDynamics.textbookBrownianGenerator m (fun x => 0) β f q +
      MolecularDynamics.textbookBrownianGroundStatePotential m U β q * f q
MolecularDynamics.textbookGibbsNormalizedGroundStateFactor {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (β : ℝ) (q : Fin Nc → ℝ) : ℝ
MolecularDynamics.textbookGibbsNormalizedGroundStateFactor_contDiff {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ)
  (hU : ContDiff ℝ (↑⊤) U) (β : ℝ) : ContDiff ℝ (↑⊤) (MolecularDynamics.textbookGibbsNormalizedGroundStateFactor U β)
MolecularDynamics.textbookGibbsNormalizedGroundStateFactor_periodic {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) :
  MolecularDynamics.textbookUnitPeriodicPotential (MolecularDynamics.textbookGibbsNormalizedGroundStateFactor U β)
MolecularDynamics.textbookGibbsNormalizedGroundStateFactor_pos {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (β : ℝ) (q : Fin Nc → ℝ) : 0 < MolecularDynamics.textbookGibbsNormalizedGroundStateFactor U β q
MolecularDynamics.textbookGibbsNormalizedGroundStateFactor_sq {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (β : ℝ) (q : Fin Nc → ℝ) :
  MolecularDynamics.textbookGibbsNormalizedGroundStateFactor U β q ^ 2 =
    (MolecularDynamics.textbookConfigurationPartition U β)⁻¹ * MolecularDynamics.textbookConfigurationGibbsWeight U β q
MolecularDynamics.textbookTorusGibbsNormalizedGroundStateFactor {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) : C(UnitAddTorus (Fin Nc), ℝ)
MolecularDynamics.textbookTorusGibbsNormalizedGroundStateFactor_lift {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ)
  (hU : ContDiff ℝ (↑⊤) U) (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (q : Fin Nc → ℝ) :
  (MolecularDynamics.textbookTorusGibbsNormalizedGroundStateFactor U hU hPU β)
      (MolecularDynamics.textbookConfigurationTorusProjection q) =
    MolecularDynamics.textbookGibbsNormalizedGroundStateFactor U β q
MolecularDynamics.textbookTorusGibbsNormalizedGroundStateFactor_sq {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ)
  (hU : ContDiff ℝ (↑⊤) U) (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ)
