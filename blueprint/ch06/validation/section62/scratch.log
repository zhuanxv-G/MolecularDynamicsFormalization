  (H : E → ℝ) (Hj : ℕ → E → ℝ) (r k : ℕ) (h : ℝ) (D : Set E) (hH : ContDiffOn ℝ 1 H D)
  (hHj : ∀ j ∈ Finset.Icc r k, ContDiffOn ℝ 1 (Hj j) D) :
  ContDiffOn ℝ 1 (MolecularDynamics.textbookTruncatedHamiltonian H Hj r k h) D
MolecularDynamics.exists_compact_C1_lipschitz_constant.{u_1} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E]
  (D B : Set E) (hD : IsOpen D) (hB : IsCompact B) (hconv : Convex ℝ B) (hBD : B ⊆ D) (H : E → ℝ)
  (hH : ContDiffOn ℝ 1 H D) : ∃ L, 0 < L ∧ ∀ u ∈ B, ∀ v ∈ B, ‖H v - H u‖ ≤ L * ‖v - u‖
MolecularDynamics.exists_uniform_textbookTruncatedHamiltonian_remainder.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  (H : E → ℝ) (Hj : ℕ → E → ℝ) (r k : ℕ) (B : Set E) (hB : IsCompact B)
  (hHj : ∀ j ∈ Finset.Icc r k, ContinuousOn (Hj j) B) :
  ∃ C,
    0 < C ∧ ∀ h ∈ Set.Icc 0 1, ∀ z ∈ B, ‖MolecularDynamics.textbookTruncatedHamiltonian H Hj r k h z - H z‖ ≤ C * h ^ r
MolecularDynamics.textbookTruncatedHamiltonian_difference_isBigO.{u_1} {E : Type u_1} [NormedAddCommGroup E] (H : E → ℝ)
  (Hj : ℕ → E → ℝ) (r k : ℕ) (B : Set E) (hB : IsCompact B) (hHj : ∀ j ∈ Finset.Icc r k, ContinuousOn (Hj j) B)
  (z : ℝ → E) (hz : ∀ h ∈ Set.Icc 0 1, z h ∈ B) :
  (fun h => MolecularDynamics.textbookTruncatedHamiltonian H Hj r k h (z h) - H (z h)) =O[nhdsWithin 0 (Set.Ioi 0)]
    fun h => h ^ r
MolecularDynamics.exists_uniform_textbookTruncatedHamiltonian_lipschitz.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [NormedSpace ℝ E] (H : E → ℝ) (Hj : ℕ → E → ℝ) (r k : ℕ) (D B : Set E) (hD : IsOpen D) (hB : IsCompact B)
  (hconv : Convex ℝ B) (hBD : B ⊆ D) (hH : ContDiffOn ℝ 1 H D) (hHj : ∀ j ∈ Finset.Icc r k, ContDiffOn ℝ 1 (Hj j) D) :
  ∃ L,
    0 < L ∧
      ∀ h ∈ Set.Icc 0 1,
        ∀ u ∈ B,
          ∀ v ∈ B,
            ‖MolecularDynamics.textbookTruncatedHamiltonian H Hj r k h v -
                  MolecularDynamics.textbookTruncatedHamiltonian H Hj r k h u‖ ≤
