      (MolecularDynamics.textbookPeriodicSmoothHaarEmbedding Nc)
        (MolecularDynamics.textbookHaarFourierPolynomial
          (UnitAddTorus.mFourierCoeff ↑↑((MolecularDynamics.textbookHaarL2Complexify Nc) x)) s))
