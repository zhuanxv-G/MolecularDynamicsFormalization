  (hg : HasDerivAt g g' t) : HasDerivAt (fun u => !₂[f u, g u]) !₂[f', g'] t
MolecularDynamics.hasDerivAt_upperTriangularFlow (α : ℝ) (z : MolecularDynamics.Position 2) (t : ℝ) :
  HasDerivAt (fun u => MolecularDynamics.upperTriangularFlow α u z)
