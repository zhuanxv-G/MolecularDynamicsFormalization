  (f g : (Fin Nc → ℝ) → ℝ) (hg : ContDiff ℝ (↑⊤) g) (hPU : MolecularDynamics.textbookUnitPeriodicPotential U)
  (hPf : MolecularDynamics.textbookUnitPeriodicPotential f) (hPg : MolecularDynamics.textbookUnitPeriodicPotential g)
