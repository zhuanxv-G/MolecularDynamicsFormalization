  (f : (Fin Nc → ℝ) → ℝ) (hf : ContDiff ℝ (↑⊤) f) (hpf : MolecularDynamics.textbookUnitPeriodicPotential f)
  (x : Fin Nc → ℝ) :
  Filter.Tendsto
    (fun t =>
      (∫ (sample : Ω),
            f (MolecularDynamics.textbookBrownianGlobalRandomConfiguration m hm U hU hPU β hβ x B t sample) ∂P -
