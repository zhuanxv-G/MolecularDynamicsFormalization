  (U : (Fin N → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U) (hp : MolecularDynamics.textbookUnitPeriodicPotential U) (β γ σ : ℝ)
  (hβ : 0 < β) (hσ : σ ^ 2 = 2 * γ / β) (F : MolecularDynamics.textbookLangevinPeriodicPhase N → ℝ)
