  (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U) (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ)
  (hβ : 0 < β) (T : ℝ) (hT : 0 ≤ T) (x : Fin Nc → ℝ) (W : ℝ → Fin Nc → ℝ) (hW : ContinuousOn W (Set.Icc 0 T)) :
  ∃ q,
    ContinuousOn q (Set.Icc 0 T) ∧
      q 0 = x ∧
        (∀ t ∈ Set.Icc 0 T,
