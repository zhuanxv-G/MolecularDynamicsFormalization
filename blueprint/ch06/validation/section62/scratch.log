  (s : Finset (Fin Nc → ℤ)) :
  (MolecularDynamics.textbookHaarMassSmoothGenerator m β) (MolecularDynamics.textbookHaarFourierPolynomial a s) =
    ∑ n ∈ s, -MolecularDynamics.textbookMassFourierFrequency m β n • MolecularDynamics.textbookFourierRealMode (a n) n
