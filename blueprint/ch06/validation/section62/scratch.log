      MolecularDynamics.textbookLangevinCanonicalWeightedFormalAdjointExpression U β γ F x *
        G x ∂MolecularDynamics.textbookLangevinCanonicalMeasure U β hβ
MolecularDynamics.textbookLangevinForwardDifferentialOperator_canonical_conjugation {N : ℕ} (U : (Fin N → ℝ) → ℝ)
  (hU : ContDiff ℝ (↑⊤) U) (hp : MolecularDynamics.textbookUnitPeriodicPotential U) (β γ σ : ℝ) (hβ : 0 < β)
  (hσ : σ ^ 2 = 2 * γ / β) (F : MolecularDynamics.textbookLangevinPeriodicPhase N → ℝ)
  (hF : ContDiff ℝ (↑⊤) (F ∘ MolecularDynamics.textbookLangevinPeriodicProjection))
  (z : MolecularDynamics.textbookLangevinPhase N) :
  MolecularDynamics.textbookLangevinForwardDifferentialOperator U γ σ
      (fun y =>
        MolecularDynamics.textbookLangevinCanonicalDensityReal U β y *
          F (MolecularDynamics.textbookLangevinPeriodicProjection y))
      z =
    MolecularDynamics.textbookLangevinCanonicalDensityReal U β z *
      MolecularDynamics.textbookLangevinCanonicalWeightedFormalAdjointExpression U β γ F
        (MolecularDynamics.textbookLangevinPeriodicProjection z)
MolecularDynamics.textbookLangevinForwardDifferentialOperator_physical_canonical_conjugation {N : ℕ}
  (U : (Fin N → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U) (hp : MolecularDynamics.textbookUnitPeriodicPotential U) (β γ : ℝ)
  (hβ : 0 < β) (hγ : 0 < γ) (F : MolecularDynamics.textbookLangevinPeriodicPhase N → ℝ)
  (hF : ContDiff ℝ (↑⊤) (F ∘ MolecularDynamics.textbookLangevinPeriodicProjection))
  (z : MolecularDynamics.textbookLangevinPhase N) :
  MolecularDynamics.textbookLangevinForwardDifferentialOperator U γ (√(2 * γ * β⁻¹))
      (fun y =>
        MolecularDynamics.textbookLangevinCanonicalDensityReal U β y *
          F (MolecularDynamics.textbookLangevinPeriodicProjection y))
      z =
    MolecularDynamics.textbookLangevinCanonicalDensityReal U β z *
      MolecularDynamics.textbookLangevinCanonicalWeightedFormalAdjointExpression U β γ F
        (MolecularDynamics.textbookLangevinPeriodicProjection z)
