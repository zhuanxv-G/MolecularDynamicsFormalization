MolecularDynamics.oneStep_energy_telescoping.{u_1} {E : Type u_1} (K : E → ℝ) (G : ℝ → E → E) (h : ℝ) (z₀ : E) (n : ℕ) :
  ∑ i ∈ Finset.range n,
      (K (MolecularDynamics.oneStepIterate G h z₀ (i + 1)) - K (MolecularDynamics.oneStepIterate G h z₀ i)) =
    K (MolecularDynamics.oneStepIterate G h z₀ n) - K z₀
MolecularDynamics.textbook_energy_drift_le_actual_defects {Nc : ℕ} (H : MolecularDynamics.SymplecticCoordinates Nc → ℝ)
  (Hj : ℕ → MolecularDynamics.SymplecticCoordinates Nc → ℝ) (r k : ℕ)
  (D B : Set (MolecularDynamics.SymplecticCoordinates Nc)) (hD : IsOpen D) (hB : IsCompact B) (hconv : Convex ℝ B)
  (hBD : B ⊆ D) (hH : ContDiffOn ℝ 1 H D) (hHj : ∀ j ∈ Finset.Icc r k, ContDiffOn ℝ 1 (Hj j) D)
  (G : ℝ → MolecularDynamics.SymplecticCoordinates Nc → MolecularDynamics.SymplecticCoordinates Nc)
  (γ : ℝ → MolecularDynamics.SymplecticCoordinates Nc → ℝ → MolecularDynamics.SymplecticCoordinates Nc)
  (hγ₀ : ∀ h ∈ Set.Icc 0 1, ∀ z ∈ B, γ h z 0 = z) (hγB : ∀ h ∈ Set.Icc 0 1, ∀ z ∈ B, ∀ t ∈ Set.Icc 0 h, γ h z t ∈ B)
  (hγ :
    ∀ h ∈ Set.Icc 0 1,
      ∀ z ∈ B,
        ∀ t ∈ Set.Icc 0 h,
          HasDerivWithinAt (γ h z)
            (MolecularDynamics.textbookHamiltonianVectorField
              (MolecularDynamics.textbookTruncatedHamiltonian H Hj r k h) (γ h z t))
            (Set.Icc 0 h) t) :
  ∃ C,
    0 < C ∧
      ∃ L,
        0 < L ∧
          ∀ h ∈ Set.Icc 0 1,
            ∀ (z₀ : MolecularDynamics.SymplecticCoordinates Nc) (n : ℕ),
              (∀ i ≤ n, MolecularDynamics.oneStepIterate G h z₀ i ∈ B) →
                ‖H (MolecularDynamics.oneStepIterate G h z₀ n) - H z₀‖ ≤
                  2 * C * h ^ r +
                    L *
                      ∑ i ∈ Finset.range n,
                        ‖G h (MolecularDynamics.oneStepIterate G h z₀ i) -
                            γ h (MolecularDynamics.oneStepIterate G h z₀ i) h‖
MolecularDynamics.energy_step_count_power_factor (r k n : ℕ) (hrk : r ≤ k) (h : ℝ) :
  ↑n * h ^ (k + 1) = ↑n * h * h ^ (k - r) * h ^ r
MolecularDynamics.textbook_energy_drift_rate_of_flow_defect {Nc : ℕ}
  (H : MolecularDynamics.SymplecticCoordinates Nc → ℝ) (Hj : ℕ → MolecularDynamics.SymplecticCoordinates Nc → ℝ)
  (r k : ℕ) (hrk : r ≤ k) (D B : Set (MolecularDynamics.SymplecticCoordinates Nc)) (hD : IsOpen D) (hB : IsCompact B)
  (hconv : Convex ℝ B) (hBD : B ⊆ D) (hH : ContDiffOn ℝ 1 H D) (hHj : ∀ j ∈ Finset.Icc r k, ContDiffOn ℝ 1 (Hj j) D)
  (G : ℝ → MolecularDynamics.SymplecticCoordinates Nc → MolecularDynamics.SymplecticCoordinates Nc)
  (γ : ℝ → MolecularDynamics.SymplecticCoordinates Nc → ℝ → MolecularDynamics.SymplecticCoordinates Nc)
  (hγ₀ : ∀ h ∈ Set.Icc 0 1, ∀ z ∈ B, γ h z 0 = z) (hγB : ∀ h ∈ Set.Icc 0 1, ∀ z ∈ B, ∀ t ∈ Set.Icc 0 h, γ h z t ∈ B)
  (hγ :
    ∀ h ∈ Set.Icc 0 1,
      ∀ z ∈ B,
        ∀ t ∈ Set.Icc 0 h,
          HasDerivWithinAt (γ h z)
            (MolecularDynamics.textbookHamiltonianVectorField
              (MolecularDynamics.textbookTruncatedHamiltonian H Hj r k h) (γ h z t))
            (Set.Icc 0 h) t)
  (A T : ℝ) (hA : 0 ≤ A) (hT : 0 ≤ T) (hdefect : ∀ h ∈ Set.Ioc 0 1, ∀ z ∈ B, ‖G h z - γ h z h‖ ≤ A * h ^ (k + 1)) :
  ∃ M,
    0 < M ∧
      ∀ h ∈ Set.Ioc 0 1,
        ∀ (z₀ : MolecularDynamics.SymplecticCoordinates Nc) (n : ℕ),
          (∀ i ≤ n, MolecularDynamics.oneStepIterate G h z₀ i ∈ B) →
            ↑n * h * h ^ (k - r) ≤ T → ‖H (MolecularDynamics.oneStepIterate G h z₀ n) - H z₀‖ ≤ M * h ^ r
