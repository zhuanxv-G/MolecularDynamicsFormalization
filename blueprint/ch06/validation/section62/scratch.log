  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (Q : UnitAddTorus (Fin Nc)) :
  Real.exp (-2 * MolecularDynamics.textbookTorusPotentialScale U hU hPU β) ≤
    MolecularDynamics.textbookConfigurationTorusGibbsDensity U β Q
MolecularDynamics.textbookTorusGibbsDensity_upper {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (Q : UnitAddTorus (Fin Nc)) :
  MolecularDynamics.textbookConfigurationTorusGibbsDensity U β Q ≤
    Real.exp (2 * MolecularDynamics.textbookTorusPotentialScale U hU hPU β)
MolecularDynamics.textbookConfigurationTorusGibbsDensity_continuous {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ)
  (hU : ContDiff ℝ (↑⊤) U) (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) :
  Continuous (MolecularDynamics.textbookConfigurationTorusGibbsDensity U β)
MolecularDynamics.textbookTorusGibbsDensity_mul_integrable {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ)) :
  MeasureTheory.Integrable (fun Q => MolecularDynamics.textbookConfigurationTorusGibbsDensity U β Q * g Q)
    MeasureTheory.volume
MolecularDynamics.textbookTorusGibbsDensity_integral {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ)) :
  ∫ (Q : UnitAddTorus (Fin Nc)), g Q ∂MolecularDynamics.textbookConfigurationTorusGibbsMeasure U β =
    ∫ (Q : UnitAddTorus (Fin Nc)), MolecularDynamics.textbookConfigurationTorusGibbsDensity U β Q * g Q
MolecularDynamics.textbookTorusGibbsIntegral_lower {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ))
  (hg : ∀ (Q : UnitAddTorus (Fin Nc)), 0 ≤ g Q) :
  Real.exp (-2 * MolecularDynamics.textbookTorusPotentialScale U hU hPU β) * ∫ (Q : UnitAddTorus (Fin Nc)), g Q ≤
    ∫ (Q : UnitAddTorus (Fin Nc)), g Q ∂MolecularDynamics.textbookConfigurationTorusGibbsMeasure U β
MolecularDynamics.textbookTorusGibbsIntegral_upper {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ))
  (hg : ∀ (Q : UnitAddTorus (Fin Nc)), 0 ≤ g Q) :
  ∫ (Q : UnitAddTorus (Fin Nc)), g Q ∂MolecularDynamics.textbookConfigurationTorusGibbsMeasure U β ≤
    Real.exp (2 * MolecularDynamics.textbookTorusPotentialScale U hU hPU β) * ∫ (Q : UnitAddTorus (Fin Nc)), g Q
MolecularDynamics.textbookTorusGibbsSquareIntegral_lower {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ)) :
  Real.exp (-2 * MolecularDynamics.textbookTorusPotentialScale U hU hPU β) * ∫ (Q : UnitAddTorus (Fin Nc)), g Q ^ 2 ≤
    ∫ (Q : UnitAddTorus (Fin Nc)), g Q ^ 2 ∂MolecularDynamics.textbookConfigurationTorusGibbsMeasure U β
MolecularDynamics.textbookTorusGibbsSquareIntegral_upper {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ)) :
  ∫ (Q : UnitAddTorus (Fin Nc)), g Q ^ 2 ∂MolecularDynamics.textbookConfigurationTorusGibbsMeasure U β ≤
    Real.exp (2 * MolecularDynamics.textbookTorusPotentialScale U hU hPU β) * ∫ (Q : UnitAddTorus (Fin Nc)), g Q ^ 2
MolecularDynamics.textbookGibbsContinuousToLp_norm_sq {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ)) :
  ‖(MolecularDynamics.textbookGibbsContinuousToLp U hU hPU β) g‖ ^ 2 =
    ∫ (Q : UnitAddTorus (Fin Nc)), g Q ^ 2 ∂MolecularDynamics.textbookConfigurationTorusGibbsMeasure U β
MolecularDynamics.textbookGibbsContinuousToLp_norm_sq_lower {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ)) :
  Real.exp (-2 * MolecularDynamics.textbookTorusPotentialScale U hU hPU β) * ∫ (Q : UnitAddTorus (Fin Nc)), g Q ^ 2 ≤
    ‖(MolecularDynamics.textbookGibbsContinuousToLp U hU hPU β) g‖ ^ 2
MolecularDynamics.textbookGibbsContinuousToLp_norm_sq_upper {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ)) :
  ‖(MolecularDynamics.textbookGibbsContinuousToLp U hU hPU β) g‖ ^ 2 ≤
    Real.exp (2 * MolecularDynamics.textbookTorusPotentialScale U hU hPU β) * ∫ (Q : UnitAddTorus (Fin Nc)), g Q ^ 2
MolecularDynamics.textbookGibbsMean {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ)) : ℝ
MolecularDynamics.textbookGibbsVariance {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ)) : ℝ
MolecularDynamics.textbookGibbsCenteredContinuous {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (β : ℝ)
  (g : C(UnitAddTorus (Fin Nc), ℝ)) : C(UnitAddTorus (Fin Nc), ℝ)
MolecularDynamics.textbookGibbsContinuous_memLp_two {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ)) :
  MeasureTheory.MemLp (fun Q => g Q) 2 (MolecularDynamics.textbookConfigurationTorusGibbsMeasure U β)
MolecularDynamics.textbookGibbsContinuous_integrable {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ)) :
  MeasureTheory.Integrable (fun Q => g Q) (MolecularDynamics.textbookConfigurationTorusGibbsMeasure U β)
MolecularDynamics.textbookGibbsCenteredContinuous_mean_zero {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ)) :
  MolecularDynamics.textbookGibbsMean U β (MolecularDynamics.textbookGibbsCenteredContinuous U β g) = 0
MolecularDynamics.textbookGibbsVariance_eq_variance {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (β : ℝ)
  (g : C(UnitAddTorus (Fin Nc), ℝ)) :
  MolecularDynamics.textbookGibbsVariance U β g =
    ProbabilityTheory.variance (fun Q => g Q) (MolecularDynamics.textbookConfigurationTorusGibbsMeasure U β)
MolecularDynamics.textbookGibbsVariance_eq_sub {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ)) :
  MolecularDynamics.textbookGibbsVariance U β g =
    ∫ (Q : UnitAddTorus (Fin Nc)), g Q ^ 2 ∂MolecularDynamics.textbookConfigurationTorusGibbsMeasure U β -
      MolecularDynamics.textbookGibbsMean U β g ^ 2
MolecularDynamics.textbookGibbsVariance_nonneg {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (β : ℝ)
  (g : C(UnitAddTorus (Fin Nc), ℝ)) : 0 ≤ MolecularDynamics.textbookGibbsVariance U β g
MolecularDynamics.textbookGibbsVariance_le_square_sub_const {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ)) (c : ℝ) :
  MolecularDynamics.textbookGibbsVariance U β g ≤
    ∫ (Q : UnitAddTorus (Fin Nc)), (g Q - c) ^ 2 ∂MolecularDynamics.textbookConfigurationTorusGibbsMeasure U β
MolecularDynamics.textbookGibbsVariance_eq_zero_iff {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ)) :
  MolecularDynamics.textbookGibbsVariance U β g = 0 ↔
    ∀ (Q : UnitAddTorus (Fin Nc)), g Q = MolecularDynamics.textbookGibbsMean U β g
MolecularDynamics.textbookGibbsCenteredContinuous_norm_sq {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ)) :
  ‖(MolecularDynamics.textbookGibbsContinuousToLp U hU hPU β)
          (MolecularDynamics.textbookGibbsCenteredContinuous U β g)‖ ^
      2 =
    MolecularDynamics.textbookGibbsVariance U β g
MolecularDynamics.textbookGibbsContinuousToLp_inner_one {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ)) :
  inner ℝ ((MolecularDynamics.textbookGibbsContinuousToLp U hU hPU β) (ContinuousMap.const (UnitAddTorus (Fin Nc)) 1))
      ((MolecularDynamics.textbookGibbsContinuousToLp U hU hPU β) g) =
    MolecularDynamics.textbookGibbsMean U β g
MolecularDynamics.textbookGibbsContinuousToLp_orthogonal_one_iff {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ)
  (hU : ContDiff ℝ (↑⊤) U) (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ)
  (g : C(UnitAddTorus (Fin Nc), ℝ)) :
  inner ℝ ((MolecularDynamics.textbookGibbsContinuousToLp U hU hPU β) (ContinuousMap.const (UnitAddTorus (Fin Nc)) 1))
        ((MolecularDynamics.textbookGibbsContinuousToLp U hU hPU β) g) =
      0 ↔
    MolecularDynamics.textbookGibbsMean U β g = 0
MolecularDynamics.textbookGibbsVariance_le_haar_centered_square {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ)) :
  MolecularDynamics.textbookGibbsVariance U β g ≤
    Real.exp (2 * MolecularDynamics.textbookTorusPotentialScale U hU hPU β) *
      ∫ (Q : UnitAddTorus (Fin Nc)), (g Q - ∫ (R : UnitAddTorus (Fin Nc)), g R) ^ 2
MolecularDynamics.textbookTorusHaarMean {Nc : ℕ} (g : C(UnitAddTorus (Fin Nc), ℝ)) : ℝ
MolecularDynamics.textbookTorusHaarVariance {Nc : ℕ} (g : C(UnitAddTorus (Fin Nc), ℝ)) : ℝ
MolecularDynamics.textbookGibbsVariance_le_haar_variance {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ)) :
  MolecularDynamics.textbookGibbsVariance U β g ≤
    Real.exp (2 * MolecularDynamics.textbookTorusPotentialScale U hU hPU β) *
      MolecularDynamics.textbookTorusHaarVariance g
MolecularDynamics.textbookGibbsVariance_sub_const {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ)) (c : ℝ) :
  MolecularDynamics.textbookGibbsVariance U β (g - ContinuousMap.const (UnitAddTorus (Fin Nc)) c) =
    MolecularDynamics.textbookGibbsVariance U β g
MolecularDynamics.textbookGibbsCenteredContinuous_variance {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (g : C(UnitAddTorus (Fin Nc), ℝ)) :
  MolecularDynamics.textbookGibbsVariance U β (MolecularDynamics.textbookGibbsCenteredContinuous U β g) =
    MolecularDynamics.textbookGibbsVariance U β g
MolecularDynamics.textbookFourierPhase {Nc : ℕ} (n : Fin Nc → ℤ) : (Fin Nc → ℝ) →L[ℝ] ℝ
MolecularDynamics.textbookFourierPhase_apply {Nc : ℕ} (n : Fin Nc → ℤ) (q : Fin Nc → ℝ) :
  (MolecularDynamics.textbookFourierPhase n) q = 2 * Real.pi * ∑ i, ↑(n i) * q i
MolecularDynamics.textbookFourierPhase_single {Nc : ℕ} (n : Fin Nc → ℤ) (i : Fin Nc) :
  (MolecularDynamics.textbookFourierPhase n) (Pi.single i 1) = 2 * Real.pi * ↑(n i)
MolecularDynamics.textbookFourierCosineLift {Nc : ℕ} (n : Fin Nc → ℤ) (q : Fin Nc → ℝ) : ℝ
MolecularDynamics.textbookFourierSineLift {Nc : ℕ} (n : Fin Nc → ℤ) (q : Fin Nc → ℝ) : ℝ
MolecularDynamics.textbookFourierCosineLift_contDiff {Nc : ℕ} (n : Fin Nc → ℤ) :
  ContDiff ℝ (↑⊤) (MolecularDynamics.textbookFourierCosineLift n)
MolecularDynamics.textbookFourierSineLift_contDiff {Nc : ℕ} (n : Fin Nc → ℤ) :
  ContDiff ℝ (↑⊤) (MolecularDynamics.textbookFourierSineLift n)
MolecularDynamics.textbookFourierCosineLift_hasFDerivAt {Nc : ℕ} (n : Fin Nc → ℤ) (q : Fin Nc → ℝ) :
  HasFDerivAt (MolecularDynamics.textbookFourierCosineLift n)
    (-Real.sin ((MolecularDynamics.textbookFourierPhase n) q) • MolecularDynamics.textbookFourierPhase n) q
MolecularDynamics.textbookFourierSineLift_hasFDerivAt {Nc : ℕ} (n : Fin Nc → ℤ) (q : Fin Nc → ℝ) :
  HasFDerivAt (MolecularDynamics.textbookFourierSineLift n)
    (Real.cos ((MolecularDynamics.textbookFourierPhase n) q) • MolecularDynamics.textbookFourierPhase n) q
MolecularDynamics.textbookFourierCosineLift_partial {Nc : ℕ} (n : Fin Nc → ℤ) (i : Fin Nc) :
  MolecularDynamics.textbookConfigurationPartial (MolecularDynamics.textbookFourierCosineLift n) i = fun q =>
    -(2 * Real.pi * ↑(n i)) * MolecularDynamics.textbookFourierSineLift n q
MolecularDynamics.textbookFourierSineLift_partial {Nc : ℕ} (n : Fin Nc → ℤ) (i : Fin Nc) :
  MolecularDynamics.textbookConfigurationPartial (MolecularDynamics.textbookFourierSineLift n) i = fun q =>
    2 * Real.pi * ↑(n i) * MolecularDynamics.textbookFourierCosineLift n q
MolecularDynamics.textbookFourierPhase_integer_apply {Nc : ℕ} (n z : Fin Nc → ℤ) :
  ((MolecularDynamics.textbookFourierPhase n) fun i => ↑(z i)) = ↑(∑ i, n i * z i) * (2 * Real.pi)
MolecularDynamics.textbookFourierCosineLift_periodic {Nc : ℕ} (n : Fin Nc → ℤ) :
  MolecularDynamics.textbookUnitPeriodicPotential (MolecularDynamics.textbookFourierCosineLift n)
MolecularDynamics.textbookFourierSineLift_periodic {Nc : ℕ} (n : Fin Nc → ℤ) :
  MolecularDynamics.textbookUnitPeriodicPotential (MolecularDynamics.textbookFourierSineLift n)
MolecularDynamics.textbookFourierCosineLift_second_partial {Nc : ℕ} (n : Fin Nc → ℤ) (i : Fin Nc) :
  MolecularDynamics.textbookConfigurationPartial
      (MolecularDynamics.textbookConfigurationPartial (MolecularDynamics.textbookFourierCosineLift n) i) i =
    fun q => -(2 * Real.pi * ↑(n i)) ^ 2 * MolecularDynamics.textbookFourierCosineLift n q
MolecularDynamics.textbookFourierSineLift_second_partial {Nc : ℕ} (n : Fin Nc → ℤ) (i : Fin Nc) :
  MolecularDynamics.textbookConfigurationPartial
      (MolecularDynamics.textbookConfigurationPartial (MolecularDynamics.textbookFourierSineLift n) i) i =
    fun q => -(2 * Real.pi * ↑(n i)) ^ 2 * MolecularDynamics.textbookFourierSineLift n q
MolecularDynamics.textbookTorusFourier_lift_exp {Nc : ℕ} (n : Fin Nc → ℤ) (q : Fin Nc → ℝ) :
  (UnitAddTorus.mFourier n) (MolecularDynamics.textbookConfigurationTorusProjection q) =
    Complex.exp (↑((MolecularDynamics.textbookFourierPhase n) q) * Complex.I)
MolecularDynamics.textbookTorusFourier_lift_re {Nc : ℕ} (n : Fin Nc → ℤ) (q : Fin Nc → ℝ) :
  ((UnitAddTorus.mFourier n) (MolecularDynamics.textbookConfigurationTorusProjection q)).re =
    MolecularDynamics.textbookFourierCosineLift n q
MolecularDynamics.textbookTorusFourier_lift_im {Nc : ℕ} (n : Fin Nc → ℤ) (q : Fin Nc → ℝ) :
  ((UnitAddTorus.mFourier n) (MolecularDynamics.textbookConfigurationTorusProjection q)).im =
    MolecularDynamics.textbookFourierSineLift n q
MolecularDynamics.textbookFourierLaplaceFrequency {Nc : ℕ} (n : Fin Nc → ℤ) : ℝ
MolecularDynamics.textbookFourierLaplaceFrequency_zero (Nc : ℕ) :
  MolecularDynamics.textbookFourierLaplaceFrequency 0 = 0
MolecularDynamics.textbookFourier_integer_sum_sq_lower {Nc : ℕ} (n : Fin Nc → ℤ) (hn : n ≠ 0) : 1 ≤ ∑ i, ↑(n i) ^ 2
MolecularDynamics.textbookFourierLaplaceFrequency_lower {Nc : ℕ} (n : Fin Nc → ℤ) (hn : n ≠ 0) :
  4 * Real.pi ^ 2 ≤ MolecularDynamics.textbookFourierLaplaceFrequency n
MolecularDynamics.textbookBrownianGenerator_flat {Nc : ℕ} (f : (Fin Nc → ℝ) → ℝ) (q : Fin Nc → ℝ) :
  MolecularDynamics.textbookBrownianGenerator (fun x => 1) (fun x => 0) 1 f q =
    ∑ i, MolecularDynamics.textbookConfigurationPartial (MolecularDynamics.textbookConfigurationPartial f i) i q
MolecularDynamics.textbookFourierCosineLift_flat_generator {Nc : ℕ} (n : Fin Nc → ℤ) (q : Fin Nc → ℝ) :
  MolecularDynamics.textbookBrownianGenerator (fun x => 1) (fun x => 0) 1
      (MolecularDynamics.textbookFourierCosineLift n) q =
    -MolecularDynamics.textbookFourierLaplaceFrequency n * MolecularDynamics.textbookFourierCosineLift n q
MolecularDynamics.textbookFourierSineLift_flat_generator {Nc : ℕ} (n : Fin Nc → ℤ) (q : Fin Nc → ℝ) :
  MolecularDynamics.textbookBrownianGenerator (fun x => 1) (fun x => 0) 1 (MolecularDynamics.textbookFourierSineLift n)
      q =
    -MolecularDynamics.textbookFourierLaplaceFrequency n * MolecularDynamics.textbookFourierSineLift n q
MolecularDynamics.textbookConfigurationPartition_zero (Nc : ℕ) (β : ℝ) :
  MolecularDynamics.textbookConfigurationPartition (fun x => 0) β = 1
MolecularDynamics.textbookConfigurationTorusGibbsMeasure_zero (Nc : ℕ) (β : ℝ) :
  MolecularDynamics.textbookConfigurationTorusGibbsMeasure (fun x => 0) β = MeasureTheory.volume
MolecularDynamics.textbookHaarLaplace_dirichlet {Nc : ℕ} (f g : (Fin Nc → ℝ) → ℝ) (hf : ContDiff ℝ (↑⊤) f)
  (hg : ContDiff ℝ (↑⊤) g) (hPf : MolecularDynamics.textbookUnitPeriodicPotential f)
  (hPg : MolecularDynamics.textbookUnitPeriodicPotential g) :
  ∫ (Q : UnitAddTorus (Fin Nc)),
      MolecularDynamics.textbookConfigurationTorusObservable f Q *
        MolecularDynamics.textbookConfigurationTorusObservable
          (MolecularDynamics.textbookBrownianGenerator (fun x => 1) (fun x => 0) 1 g) Q =
    -∫ (Q : UnitAddTorus (Fin Nc)),
        MolecularDynamics.textbookConfigurationTorusObservable
          (MolecularDynamics.textbookConfigurationGradientPair (fun x => 1) f g) Q
MolecularDynamics.textbookHaarLaplace_symmetric {Nc : ℕ} (f g : (Fin Nc → ℝ) → ℝ) (hf : ContDiff ℝ (↑⊤) f)
  (hg : ContDiff ℝ (↑⊤) g) (hPf : MolecularDynamics.textbookUnitPeriodicPotential f)
  (hPg : MolecularDynamics.textbookUnitPeriodicPotential g) :
  ∫ (Q : UnitAddTorus (Fin Nc)),
      MolecularDynamics.textbookConfigurationTorusObservable f Q *
        MolecularDynamics.textbookConfigurationTorusObservable
          (MolecularDynamics.textbookBrownianGenerator (fun x => 1) (fun x => 0) 1 g) Q =
    ∫ (Q : UnitAddTorus (Fin Nc)),
      MolecularDynamics.textbookConfigurationTorusObservable
          (MolecularDynamics.textbookBrownianGenerator (fun x => 1) (fun x => 0) 1 f) Q *
        MolecularDynamics.textbookConfigurationTorusObservable g Q
MolecularDynamics.textbookTorusFourier_cosine_observable {Nc : ℕ} (n : Fin Nc → ℤ) (Q : UnitAddTorus (Fin Nc)) :
  MolecularDynamics.textbookConfigurationTorusObservable (MolecularDynamics.textbookFourierCosineLift n) Q =
    ((UnitAddTorus.mFourier n) Q).re
MolecularDynamics.textbookTorusFourier_sine_observable {Nc : ℕ} (n : Fin Nc → ℤ) (Q : UnitAddTorus (Fin Nc)) :
  MolecularDynamics.textbookConfigurationTorusObservable (MolecularDynamics.textbookFourierSineLift n) Q =
    ((UnitAddTorus.mFourier n) Q).im
MolecularDynamics.textbookHaarLaplace_cosine_pairing {Nc : ℕ} (f : (Fin Nc → ℝ) → ℝ) (hf : ContDiff ℝ (↑⊤) f)
  (hPf : MolecularDynamics.textbookUnitPeriodicPotential f) (n : Fin Nc → ℤ) :
  ∫ (Q : UnitAddTorus (Fin Nc)),
      MolecularDynamics.textbookConfigurationTorusObservable (MolecularDynamics.textbookFourierCosineLift n) Q *
        MolecularDynamics.textbookConfigurationTorusObservable
          (MolecularDynamics.textbookBrownianGenerator (fun x => 1) (fun x => 0) 1 f) Q =
    -MolecularDynamics.textbookFourierLaplaceFrequency n *
      ∫ (Q : UnitAddTorus (Fin Nc)),
        MolecularDynamics.textbookConfigurationTorusObservable (MolecularDynamics.textbookFourierCosineLift n) Q *
          MolecularDynamics.textbookConfigurationTorusObservable f Q
MolecularDynamics.textbookHaarLaplace_sine_pairing {Nc : ℕ} (f : (Fin Nc → ℝ) → ℝ) (hf : ContDiff ℝ (↑⊤) f)
  (hPf : MolecularDynamics.textbookUnitPeriodicPotential f) (n : Fin Nc → ℤ) :
  ∫ (Q : UnitAddTorus (Fin Nc)),
      MolecularDynamics.textbookConfigurationTorusObservable (MolecularDynamics.textbookFourierSineLift n) Q *
        MolecularDynamics.textbookConfigurationTorusObservable
          (MolecularDynamics.textbookBrownianGenerator (fun x => 1) (fun x => 0) 1 f) Q =
    -MolecularDynamics.textbookFourierLaplaceFrequency n *
      ∫ (Q : UnitAddTorus (Fin Nc)),
        MolecularDynamics.textbookConfigurationTorusObservable (MolecularDynamics.textbookFourierSineLift n) Q *
          MolecularDynamics.textbookConfigurationTorusObservable f Q
