    -σ ^ 2 *
      ∫ (x : MolecularDynamics.textbookLangevinPeriodicPhase N),
        ∑ i,
          MolecularDynamics.textbookLangevinPeriodicDirectionalDerivative F (0, Pi.single i 1) x *
            MolecularDynamics.textbookLangevinPeriodicDirectionalDerivative G (0, Pi.single i 1)
              x ∂MolecularDynamics.textbookLangevinCanonicalMeasure U β hβ
