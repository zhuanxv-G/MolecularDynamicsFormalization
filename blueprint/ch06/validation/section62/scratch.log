  (F : MolecularDynamics.textbookLangevinPeriodicPhase N → ℝ) (δ : ℝ) (hδ : 0 < δ)
  (z : MolecularDynamics.textbookLangevinPhase N) :
  MolecularDynamics.textbookLangevinPeriodicSmoothApproximation F δ hδ
      (MolecularDynamics.textbookLangevinPeriodicProjection z) =
    MeasureTheory.convolution (MolecularDynamics.phase_smooth_kernel✝ δ hδ)
      (F ∘ MolecularDynamics.textbookLangevinPeriodicProjection) (ContinuousLinearMap.lsmul ℝ ℝ)
      MeasureTheory.Measure.addHaar z
