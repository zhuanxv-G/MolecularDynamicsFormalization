  (PowerSeries.coeff j) (MolecularDynamics.textbookFormalOperatorLogarithm S) =
    ∑ n ∈ Finset.range N, ((-1) ^ (n + 1) / ↑n) • (PowerSeries.coeff j) ((S - 1) ^ n)
MolecularDynamics.textbookFormalOperatorLogarithm_coeff_one.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R]
  (S : PowerSeries R) :
  (PowerSeries.coeff 1) (MolecularDynamics.textbookFormalOperatorLogarithm S) = (PowerSeries.coeff 1) S
MolecularDynamics.textbookFormalOperatorLogarithm_coeff_two.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R]
  (S : PowerSeries R) (hS : PowerSeries.constantCoeff S = 1) :
  (PowerSeries.coeff 2) (MolecularDynamics.textbookFormalOperatorLogarithm S) =
    (PowerSeries.coeff 2) S - (1 / 2) • (PowerSeries.coeff 1) S ^ 2
MolecularDynamics.textbookFormalOperatorLogarithm_coeff_three.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R]
  (S : PowerSeries R) (hS : PowerSeries.constantCoeff S = 1) :
  (PowerSeries.coeff 3) (MolecularDynamics.textbookFormalOperatorLogarithm S) =
    (PowerSeries.coeff 3) S -
        (1 / 2) •
          ((PowerSeries.coeff 1) S * (PowerSeries.coeff 2) S + (PowerSeries.coeff 2) S * (PowerSeries.coeff 1) S) +
      (1 / 3) • (PowerSeries.coeff 1) S ^ 3
MolecularDynamics.textbookFormalOperatorLogarithm_coeff_four.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R]
  (S : PowerSeries R) (hS : PowerSeries.constantCoeff S = 1) :
  (PowerSeries.coeff 4) (MolecularDynamics.textbookFormalOperatorLogarithm S) =
    (PowerSeries.coeff 4) S -
          (1 / 2) •
            ((PowerSeries.coeff 1) S * (PowerSeries.coeff 3) S + (PowerSeries.coeff 2) S ^ 2 +
              (PowerSeries.coeff 3) S * (PowerSeries.coeff 1) S) +
        (1 / 3) •
          ((PowerSeries.coeff 1) S ^ 2 * (PowerSeries.coeff 2) S +
              (PowerSeries.coeff 1) S * (PowerSeries.coeff 2) S * (PowerSeries.coeff 1) S +
            (PowerSeries.coeff 2) S * (PowerSeries.coeff 1) S ^ 2) -
      (1 / 4) • (PowerSeries.coeff 1) S ^ 4
