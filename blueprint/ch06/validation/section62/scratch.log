  {P : MeasureTheory.Measure Ω} {W : NNReal → Ω → ℝ} (hW : ProbabilityTheory.IsPreBrownianReal W P) (T : NNReal) :
  Filter.Tendsto
    (fun K => ∫ (ω : Ω), (MolecularDynamics.textbookWienerSelfItoSum W T K ω - (W T ω ^ 2 - ↑T) / 2) ^ 2 ∂P)
