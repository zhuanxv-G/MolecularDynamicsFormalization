MolecularDynamics.realNormalMode.{u_1} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E] (Ω α β : ℝ) (u v : E)
  (t : ℝ) : E
MolecularDynamics.realNormalMode_eq_linearExponentialFlow.{u_1} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [CompleteSpace E] (A : E →L[ℝ] E) (Ω α β : ℝ) (u v : E) (hu : A u = -Ω • v) (hv : A v = Ω • u) (t : ℝ) :
  MolecularDynamics.realNormalMode Ω α β u v t = MolecularDynamics.linearExponentialFlow A t (α • v + β • u)
MolecularDynamics.mechanicalNormalMode_pair {n : ℕ} (m : MolecularDynamics.CoordinateMasses n)
  (K : MolecularDynamics.Position n →L[ℝ] MolecularDynamics.Momentum n) (Ω : ℝ) (q : MolecularDynamics.Position n)
  (hm : ∀ (i : Fin n), 0 < m i) (hq : K q = Ω ^ 2 • (MolecularDynamics.massOperator m) q) :
  (MolecularDynamics.mechanicalLinearization m (-K)) (q, 0) = -Ω • (0, Ω • (MolecularDynamics.massOperator m) q) ∧
    (MolecularDynamics.mechanicalLinearization m (-K)) (0, Ω • (MolecularDynamics.massOperator m) q) = Ω • (q, 0)
MolecularDynamics.hasDerivAt_mechanicalNormalMode {n : ℕ} (m : MolecularDynamics.CoordinateMasses n)
  (K : MolecularDynamics.Position n →L[ℝ] MolecularDynamics.Momentum n) (Ω α β : ℝ) (q : MolecularDynamics.Position n)
  (hm : ∀ (i : Fin n), 0 < m i) (hq : K q = Ω ^ 2 • (MolecularDynamics.massOperator m) q) (t : ℝ) :
  HasDerivAt (MolecularDynamics.realNormalMode Ω α β (q, 0) (0, Ω • (MolecularDynamics.massOperator m) q))
    ((MolecularDynamics.mechanicalLinearization m (-K))
      (MolecularDynamics.realNormalMode Ω α β (q, 0) (0, Ω • (MolecularDynamics.massOperator m) q) t))
    t
MolecularDynamics.IsConstantVariationalSolution.{u_1} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E]
