  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (hβ : 0 < β) (hNc : 0 < Nc) (t : NNReal)
  (x : ↥(MolecularDynamics.Gibbs✝ U β)) :
  (MolecularDynamics.textbookBrownianGibbsSpectralEvolution m hm U hU hPU β hβ t) x =
    ∑' (n : ℕ),
      (Real.exp (((MolecularDynamics.enumeration✝ m hm U hU hPU β hβ hNc) n).fst * ↑t) *
          inner ℝ ((MolecularDynamics.textbookBrownianGibbsNormalizedOrderedEigenbasis m hm U hU hPU β hβ hNc) n) x) •
        (MolecularDynamics.textbookBrownianGibbsNormalizedOrderedEigenbasis m hm U hU hPU β hβ hNc) n
