  LieSubalgebra ℝ (Module.End ℝ (MolecularDynamics.textbookThermostatPhase Nc))
MolecularDynamics.textbookThermostatLieSpan_vectorField_closed {Nc : ℕ} (A : Matrix (Fin Nc) (Fin Nc) ℝ)
  (X Y : Module.End ℝ (MolecularDynamics.textbookThermostatPhase Nc))
  (hx : X ∈ MolecularDynamics.textbookThermostatLieSpan A) (hy : Y ∈ MolecularDynamics.textbookThermostatLieSpan A) :
  ∃ Z ∈ MolecularDynamics.textbookThermostatLieSpan A,
    ∀ (z : MolecularDynamics.textbookThermostatPhase Nc), VectorField.lieBracket ℝ (fun x => X x) (fun x => Y x) z = Z z
MolecularDynamics.textbookThermostat_C_D_mem_lieSpan {Nc : ℕ} (A : Matrix (Fin Nc) (Fin Nc) ℝ) (k : ℕ) :
  MolecularDynamics.textbookThermostatC A k ∈ MolecularDynamics.textbookThermostatLieSpan A ∧
    MolecularDynamics.textbookThermostatD A k ∈ MolecularDynamics.textbookThermostatLieSpan A
