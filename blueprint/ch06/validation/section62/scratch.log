MolecularDynamics.textbookLangevinCanonicalWeakH1SmoothTest_norm_sq {N : ℕ} (U : (Fin N → ℝ) → ℝ)
  (hU : ContDiff ℝ (↑⊤) U) (hp : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (hβ : 0 < β)
  (F : MolecularDynamics.textbookLangevinPeriodicPhase N → ℝ)
  (hF : ContDiff ℝ (↑⊤) (F ∘ MolecularDynamics.textbookLangevinPeriodicProjection)) (hs : HasCompactSupport F) :
  ‖MolecularDynamics.textbookLangevinCanonicalWeakH1SmoothTest U hU hp β hβ F hF hs‖ ^ 2 =
    ∫ (x : MolecularDynamics.textbookLangevinPeriodicPhase N),
