  Module.End ℝ (MolecularDynamics.textbookThermostatPhase Nc)
MolecularDynamics.textbookThermostatEigenCoordinates_eq_dotProduct {Nc : ℕ} {A : Matrix (Fin Nc) (Fin Nc) ℝ}
  (hA : A.IsHermitian) (v : Fin Nc → ℝ) (i : Fin Nc) :
  (MolecularDynamics.textbookThermostatEigenCoordinates hA) v i = v ⬝ᵥ fun j => (hA.eigenvectorBasis i).ofLp j
MolecularDynamics.textbookThermostatEigenCoordinates_intertwine {Nc : ℕ} {A : Matrix (Fin Nc) (Fin Nc) ℝ}
  (hA : A.IsHermitian) (v : Fin Nc → ℝ) (i : Fin Nc) :
  (MolecularDynamics.textbookThermostatEigenCoordinates hA) (A.mulVec v) i =
    hA.eigenvalues i * (MolecularDynamics.textbookThermostatEigenCoordinates hA) v i
MolecularDynamics.textbookThermostatEigenCoordinates_power {Nc : ℕ} {A : Matrix (Fin Nc) (Fin Nc) ℝ}
  (hA : A.IsHermitian) (k : ℕ) (v : Fin Nc → ℝ) (i : Fin Nc) :
  (MolecularDynamics.textbookThermostatEigenCoordinates hA) ((A ^ k).mulVec v) i =
    hA.eigenvalues i ^ k * (MolecularDynamics.textbookThermostatEigenCoordinates hA) v i
MolecularDynamics.textbookThermostat_C_coordinates {Nc : ℕ} {A : Matrix (Fin Nc) (Fin Nc) ℝ} (hA : A.IsHermitian)
  (k : ℕ) (z : MolecularDynamics.textbookThermostatPhase Nc) :
  (MolecularDynamics.textbookThermostatSpectralPhase hA) ((MolecularDynamics.textbookThermostatC A k) z) =
    (fun i => hA.eigenvalues i ^ k * (MolecularDynamics.textbookThermostatEigenCoordinates hA) z.2 i, fun i =>
      hA.eigenvalues i ^ (k + 1) * (MolecularDynamics.textbookThermostatEigenCoordinates hA) z.1 i)
MolecularDynamics.textbookThermostat_D_coordinates {Nc : ℕ} {A : Matrix (Fin Nc) (Fin Nc) ℝ} (hA : A.IsHermitian)
  (k : ℕ) (z : MolecularDynamics.textbookThermostatPhase Nc) :
  (MolecularDynamics.textbookThermostatSpectralPhase hA) ((MolecularDynamics.textbookThermostatD A k) z) =
    (fun i => hA.eigenvalues i ^ (k + 1) * (MolecularDynamics.textbookThermostatEigenCoordinates hA) z.1 i, fun i =>
      -(hA.eigenvalues i ^ (k + 1) * (MolecularDynamics.textbookThermostatEigenCoordinates hA) z.2 i))
MolecularDynamics.textbookThermostatModeDomain {Nc : ℕ} {A : Matrix (Fin Nc) (Fin Nc) ℝ} (hA : A.IsHermitian) :
