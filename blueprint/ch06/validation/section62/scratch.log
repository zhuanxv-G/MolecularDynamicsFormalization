        (∫ (Q : UnitAddTorus (Fin Nc)), ↑↑g Q ∂MolecularDynamics.textbookConfigurationTorusGibbsMeasure U β) *
          ∫ (Q : UnitAddTorus (Fin Nc)), ↑↑ρ Q ∂MolecularDynamics.textbookConfigurationTorusGibbsMeasure U β| ≤
    Real.exp (-MolecularDynamics.textbookBrownianGibbsCoercivityRate m U hU hPU β * ↑t) * ‖g‖ *
      ‖ρ -
          (∫ (Q : UnitAddTorus (Fin Nc)), ↑↑ρ Q ∂MolecularDynamics.textbookConfigurationTorusGibbsMeasure U β) •
            MolecularDynamics.oneVector✝ U hU hPU β‖
MolecularDynamics.textbookBrownianGibbsSpectralEvolution_normalized_integral_decay {Nc : ℕ} (m : Fin Nc → ℝ)
  (hm : ∀ (i : Fin Nc), 0 < m i) (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (hβ : 0 < β) (ρ : ↥(MolecularDynamics.Gibbs✝ U β))
  (hρ : ∫ (Q : UnitAddTorus (Fin Nc)), ↑↑ρ Q ∂MolecularDynamics.textbookConfigurationTorusGibbsMeasure U β = 1)
  (t : NNReal) (g : ↥(MolecularDynamics.Gibbs✝ U β)) :
  |∫ (Q : UnitAddTorus (Fin Nc)),
          ↑↑g Q *
            ↑↑((MolecularDynamics.textbookBrownianGibbsSpectralEvolution m hm U hU hPU β hβ t) ρ)
              Q ∂MolecularDynamics.textbookConfigurationTorusGibbsMeasure U β -
        ∫ (Q : UnitAddTorus (Fin Nc)), ↑↑g Q ∂MolecularDynamics.textbookConfigurationTorusGibbsMeasure U β| ≤
    (‖ρ - MolecularDynamics.oneVector✝ U hU hPU β‖ + 1) * ‖g‖ *
      Real.exp (-MolecularDynamics.textbookBrownianGibbsCoercivityRate m U hU hPU β * ↑t)
MolecularDynamics.textbookBrownianGibbsSpectralEvolution_smooth_average_decay {Nc : ℕ} (m : Fin Nc → ℝ)
  (hm : ∀ (i : Fin Nc), 0 < m i) (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (hβ : 0 < β) (ρ : ↥(MolecularDynamics.Gibbs✝ U β))
  (hρ : ∫ (Q : UnitAddTorus (Fin Nc)), ↑↑ρ Q ∂MolecularDynamics.textbookConfigurationTorusGibbsMeasure U β = 1)
  (t : NNReal) (f : ↥(MolecularDynamics.textbookPeriodicSmoothSpace Nc)) :
  |∫ (Q : UnitAddTorus (Fin Nc)),
          MolecularDynamics.textbookConfigurationTorusObservable (↑f) Q *
            ↑↑((MolecularDynamics.textbookBrownianGibbsSpectralEvolution m hm U hU hPU β hβ t) ρ)
              Q ∂MolecularDynamics.textbookConfigurationTorusGibbsMeasure U β -
        (MolecularDynamics.textbookConfigurationPartition U β)⁻¹ *
          ∫ (q : Fin Nc → ℝ) in MolecularDynamics.textbookConfigurationCube Nc,
            ↑f q * MolecularDynamics.textbookConfigurationGibbsWeight U β q| ≤
    (‖ρ - MolecularDynamics.oneVector✝ U hU hPU β‖ + 1) *
        ‖(MolecularDynamics.textbookPeriodicSmoothEmbedding U hU hPU β) f‖ *
      Real.exp (-MolecularDynamics.textbookBrownianGibbsCoercivityRate m U hU hPU β * ↑t)
MolecularDynamics.textbookBrownianGibbsSpectralEvolution_smooth_average_exponential {Nc : ℕ} (m : Fin Nc → ℝ)
  (hm : ∀ (i : Fin Nc), 0 < m i) (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (hβ : 0 < β) (ρ : ↥(MolecularDynamics.Gibbs✝ U β))
  (hρ : ∫ (Q : UnitAddTorus (Fin Nc)), ↑↑ρ Q ∂MolecularDynamics.textbookConfigurationTorusGibbsMeasure U β = 1) :
  ∃ K α,
    0 < K ∧
      0 < α ∧
        ∀ (f : ↥(MolecularDynamics.textbookPeriodicSmoothSpace Nc)) (t : NNReal),
          |∫ (Q : UnitAddTorus (Fin Nc)),
                  MolecularDynamics.textbookConfigurationTorusObservable (↑f) Q *
                    ↑↑((MolecularDynamics.textbookBrownianGibbsSpectralEvolution m hm U hU hPU β hβ t) ρ)
                      Q ∂MolecularDynamics.textbookConfigurationTorusGibbsMeasure U β -
                (MolecularDynamics.textbookConfigurationPartition U β)⁻¹ *
                  ∫ (q : Fin Nc → ℝ) in MolecularDynamics.textbookConfigurationCube Nc,
                    ↑f q * MolecularDynamics.textbookConfigurationGibbsWeight U β q| ≤
            K * ‖(MolecularDynamics.textbookPeriodicSmoothEmbedding U hU hPU β) f‖ * Real.exp (-α * ↑t)
