  HasDerivWithinAt (fun r => Real.exp (γ * r) • (p r - σ • W r))
    (Real.exp (γ * s) • (MolecularDynamics.textbookPotentialForce U (q s) - (γ * σ) • W s)) (Set.Ici s) s
