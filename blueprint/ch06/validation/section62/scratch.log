MolecularDynamics.gradientLinearization_expansion {n : ℕ} (U : MolecularDynamics.PotentialEnergy n)
  (q₀ h : MolecularDynamics.Position n) :
  gradient U (q₀ + h) = (fderiv ℝ (gradient U) q₀) h + MolecularDynamics.gradientLinearizationRemainder U q₀ h
