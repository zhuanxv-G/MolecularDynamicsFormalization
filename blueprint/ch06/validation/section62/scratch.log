  (MolecularDynamics.textbookPeriodicSmoothHaarEmbedding Nc) (MolecularDynamics.textbookFourierRealMode c n) =
    (MolecularDynamics.textbookHaarL2RealPart Nc) (c • UnitAddTorus.mFourierLp 2 n)
