  ↥(MolecularDynamics.textbookPeriodicSmoothSpace Nc)
MolecularDynamics.textbookHaarFourierPolynomial_embedding {Nc : ℕ} (a : (Fin Nc → ℤ) → ℂ) (s : Finset (Fin Nc → ℤ)) :
  (MolecularDynamics.textbookPeriodicSmoothHaarEmbedding Nc) (MolecularDynamics.textbookHaarFourierPolynomial a s) =
    ∑ n ∈ s, (MolecularDynamics.textbookHaarL2RealPart Nc) (a n • UnitAddTorus.mFourierLp 2 n)
