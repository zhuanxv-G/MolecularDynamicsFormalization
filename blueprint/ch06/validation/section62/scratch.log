  ↑(MolecularDynamics.textbookFourierRealMode c n) q =
    c.re * MolecularDynamics.textbookFourierCosineLift n q - c.im * MolecularDynamics.textbookFourierSineLift n q
MolecularDynamics.textbookFourierRealMode_observable {Nc : ℕ} (c : ℂ) (n : Fin Nc → ℤ) (Q : UnitAddTorus (Fin Nc)) :
  (MolecularDynamics.textbookPeriodicSmoothContinuous (MolecularDynamics.textbookFourierRealMode c n)) Q =
    (c * (UnitAddTorus.mFourier n) Q).re
