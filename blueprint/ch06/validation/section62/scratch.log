MolecularDynamics.textbookThermostatD {Nc : ℕ} (A : Matrix (Fin Nc) (Fin Nc) ℝ) (k : ℕ) :
  Module.End ℝ (MolecularDynamics.textbookThermostatPhase Nc)
MolecularDynamics.textbookThermostatF_apply {Nc : ℕ} (A : Matrix (Fin Nc) (Fin Nc) ℝ)
  (z : MolecularDynamics.textbookThermostatPhase Nc) :
  (MolecularDynamics.textbookThermostatF A) z = (z.2, -A.mulVec z.1)
MolecularDynamics.textbookThermostatG_apply (Nc : ℕ) (z : MolecularDynamics.textbookThermostatPhase Nc) :
  (MolecularDynamics.textbookThermostatG Nc) z = (0, z.2)
MolecularDynamics.textbookThermostatC_apply {Nc : ℕ} (A : Matrix (Fin Nc) (Fin Nc) ℝ) (k : ℕ)
  (z : MolecularDynamics.textbookThermostatPhase Nc) :
  (MolecularDynamics.textbookThermostatC A k) z = ((A ^ k).mulVec z.2, (A ^ (k + 1)).mulVec z.1)
MolecularDynamics.textbookThermostatD_apply {Nc : ℕ} (A : Matrix (Fin Nc) (Fin Nc) ℝ) (k : ℕ)
  (z : MolecularDynamics.textbookThermostatPhase Nc) :
  (MolecularDynamics.textbookThermostatD A k) z = ((A ^ (k + 1)).mulVec z.1, -(A ^ (k + 1)).mulVec z.2)
MolecularDynamics.textbookThermostatLinearField_lieBracket {Nc : ℕ}
  (X Y : Module.End ℝ (MolecularDynamics.textbookThermostatPhase Nc))
  (z : MolecularDynamics.textbookThermostatPhase Nc) :
  VectorField.lieBracket ℝ (fun x => X x) (fun x => Y x) z = -⁅X, Y⁆ z
MolecularDynamics.textbookThermostat_lie_F_G {Nc : ℕ} (A : Matrix (Fin Nc) (Fin Nc) ℝ) :
  ⁅MolecularDynamics.textbookThermostatF A, MolecularDynamics.textbookThermostatG Nc⁆ =
    MolecularDynamics.textbookThermostatC A 0
MolecularDynamics.textbookThermostat_lie_F_C {Nc : ℕ} (A : Matrix (Fin Nc) (Fin Nc) ℝ) (k : ℕ) :
  (1 / 2) • ⁅MolecularDynamics.textbookThermostatF A, MolecularDynamics.textbookThermostatC A k⁆ =
    MolecularDynamics.textbookThermostatD A k
MolecularDynamics.textbookThermostat_lie_D_F {Nc : ℕ} (A : Matrix (Fin Nc) (Fin Nc) ℝ) (k : ℕ) :
  (1 / 2) • ⁅MolecularDynamics.textbookThermostatD A k, MolecularDynamics.textbookThermostatF A⁆ =
    MolecularDynamics.textbookThermostatC A (k + 1)
