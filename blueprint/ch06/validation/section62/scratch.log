MolecularDynamics.linearExponentialFlow_isConstantVariationalSolution.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [NormedSpace ℝ E] [CompleteSpace E] (A : E →L[ℝ] E) (w₀ : E) :
  MolecularDynamics.IsConstantVariationalSolution A (fun t => MolecularDynamics.linearExponentialFlow A t w₀) w₀
MolecularDynamics.constantVariationalSolution_unique.{u_1} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [CompleteSpace E] (A : E →L[ℝ] E) (W : ℝ → E) (w₀ : E) (hW : MolecularDynamics.IsConstantVariationalSolution A W w₀) :
  W = fun t => MolecularDynamics.linearExponentialFlow A t w₀
MolecularDynamics.matrixExponential_zero {m : ℕ} : NormedSpace.exp 0 = 1
MolecularDynamics.matrixExponential_add_of_commute {m : ℕ} (A B : Matrix (Fin m) (Fin m) ℝ) (h : Commute A B) :
  NormedSpace.exp (A + B) = NormedSpace.exp A * NormedSpace.exp B
MolecularDynamics.matrixExponential_neg {m : ℕ} (A : Matrix (Fin m) (Fin m) ℝ) :
  NormedSpace.exp (-A) = (NormedSpace.exp A)⁻¹
MolecularDynamics.matrixExponentialFlow_realEigenmode {m : ℕ} (A : Matrix (Fin m) (Fin m) ℝ) (ω : ℝ)
  (v : MolecularDynamics.Position m) (hA : WithLp.toLp 2 (A.mulVec v.ofLp) = ω • v) (t : ℝ) :
  MolecularDynamics.matrixExponentialFlow A t v = Real.exp (ω * t) • v
MolecularDynamics.matrixExponentialFlow_diagonal {m : ℕ} (d : Fin m → ℝ) (t : ℝ) (z : MolecularDynamics.Position m) :
  MolecularDynamics.matrixExponentialFlow (Matrix.diagonal d) t z = WithLp.toLp 2 fun i => Real.exp (t * d i) * z.ofLp i
MolecularDynamics.matrixExponential_conjugate {m : ℕ} (X D : Matrix (Fin m) (Fin m) ℝ) (hX : IsUnit X) :
  NormedSpace.exp (X * D * X⁻¹) = X * NormedSpace.exp D * X⁻¹
