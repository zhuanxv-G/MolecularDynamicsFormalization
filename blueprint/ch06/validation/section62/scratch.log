MolecularDynamics.twoBody_separation_roundtrip (qcm δ : MolecularDynamics.Position 2) :
  MolecularDynamics.twoBodySeparation (qcm - (1 / 2) • δ) (qcm + (1 / 2) • δ) = δ
MolecularDynamics.twoBody_equalMass_kinetic_decomposition (m : ℝ) (v₁ v₂ : MolecularDynamics.Velocity 2) :
  m * ‖v₁‖ ^ 2 / 2 + m * ‖v₂‖ ^ 2 / 2 =
    m * ‖MolecularDynamics.twoBodyCenterVelocity v₁ v₂‖ ^ 2 +
      m / 4 * ‖MolecularDynamics.twoBodyRelativeVelocity v₁ v₂‖ ^ 2
MolecularDynamics.twoBodyRadialLagrangian (m : ℝ) (φ : ℝ → ℝ) (q₁ q₂ : MolecularDynamics.Position 2)
  (v₁ v₂ : MolecularDynamics.Velocity 2) : ℝ
MolecularDynamics.twoBody_equalMass_lagrangian_center_relative (m : ℝ) (φ : ℝ → ℝ)
  (q₁ q₂ : MolecularDynamics.Position 2) (v₁ v₂ : MolecularDynamics.Velocity 2) :
  MolecularDynamics.twoBodyRadialLagrangian m φ q₁ q₂ v₁ v₂ =
    m * ‖MolecularDynamics.twoBodyCenterVelocity v₁ v₂‖ ^ 2 +
        m / 4 * ‖MolecularDynamics.twoBodyRelativeVelocity v₁ v₂‖ ^ 2 -
      φ ‖MolecularDynamics.twoBodySeparation q₁ q₂‖
