  (γ : (Fin Nc → ℝ) → ℝ) (hγ : ContDiff ℝ 2 γ) (μ : E → ℝ) (q p : E → Fin Nc → ℝ) (x : E) (hq : DifferentiableAt ℝ q x)
  (hp : DifferentiableAt ℝ p x) (hμ : DifferentiableAt ℝ μ x) (hchart : ∀ᶠ (y : E) in nhds x, γ (q y) = 0) (u v : E) :
  ∑ i,
      ((fderiv ℝ q x) u i * (fderiv ℝ (MolecularDynamics.textbookConstrainedMomentum γ μ q p) x) v i -
        (fderiv ℝ (MolecularDynamics.textbookConstrainedMomentum γ μ q p) x) u i * (fderiv ℝ q x) v i) =
    ∑ i, ((fderiv ℝ q x) u i * (fderiv ℝ p x) v i - (fderiv ℝ p x) u i * (fderiv ℝ q x) v i)
