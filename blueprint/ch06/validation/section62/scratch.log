MolecularDynamics.textbookBrownianWeightedFlux_partial {Nc : ℕ} (m : Fin Nc → ℝ) (U : (Fin Nc → ℝ) → ℝ) (β : ℝ)
  (f g : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U) (hf : ContDiff ℝ (↑⊤) f) (hg : ContDiff ℝ (↑⊤) g) (i : Fin Nc)
  (q : Fin Nc → ℝ) :
  MolecularDynamics.textbookConfigurationPartial (MolecularDynamics.textbookBrownianWeightedFlux m U β f g i) i q =
    (m i)⁻¹ *
      ((MolecularDynamics.textbookConfigurationPartial f i q * MolecularDynamics.textbookConfigurationPartial g i q +
            f q *
              MolecularDynamics.textbookConfigurationPartial (MolecularDynamics.textbookConfigurationPartial g i) i q -
          β * f q * MolecularDynamics.textbookConfigurationPartial g i q *
            MolecularDynamics.textbookConfigurationPartial U i q) *
        MolecularDynamics.textbookConfigurationGibbsWeight U β q)
