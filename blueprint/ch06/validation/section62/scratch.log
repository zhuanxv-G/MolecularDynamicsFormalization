MolecularDynamics.textbookLangevinPeriodicDifferentialOperator_smooth_add {N : ℕ} (U : (Fin N → ℝ) → ℝ) (γ σ : ℝ)
  (F G : MolecularDynamics.textbookLangevinPeriodicPhase N → ℝ)
  (hF : ContDiff ℝ (↑⊤) (F ∘ MolecularDynamics.textbookLangevinPeriodicProjection))
  (hG : ContDiff ℝ (↑⊤) (G ∘ MolecularDynamics.textbookLangevinPeriodicProjection))
  (x : MolecularDynamics.textbookLangevinPeriodicPhase N) :
  MolecularDynamics.textbookLangevinPeriodicDifferentialOperator U γ σ (F + G) x =
