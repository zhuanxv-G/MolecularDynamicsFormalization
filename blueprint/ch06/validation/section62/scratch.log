    MolecularDynamics.textbookComposeMaps (fun t => ⇑(G₁ t)) (fun t => ⇑(G₂ t)) h
MolecularDynamics.textbookAdjointMethod_comp.{u_1} {E : Type u_1} (G₁ G₂ : ℝ → Equiv.Perm E) :
  MolecularDynamics.textbookAdjointMethod (MolecularDynamics.textbookComposeMethods G₁ G₂) =
    MolecularDynamics.textbookComposeMethods (MolecularDynamics.textbookAdjointMethod G₂)
      (MolecularDynamics.textbookAdjointMethod G₁)
MolecularDynamics.textbookSymmetricComposition.{u_1} {E : Type u_1} (G : ℝ → Equiv.Perm E) : ℝ → Equiv.Perm E
MolecularDynamics.textbookSymmetricComposition_isSelfAdjoint.{u_1} {E : Type u_1} (G : ℝ → Equiv.Perm E) :
  MolecularDynamics.textbookAdjointMethod (MolecularDynamics.textbookSymmetricComposition G) =
    MolecularDynamics.textbookSymmetricComposition G
MolecularDynamics.textbookComposeMethods_isSymplectic {Nc : ℕ}
  (G₁ G₂ : ℝ → Equiv.Perm (MolecularDynamics.SymplecticCoordinates Nc))
  (hG₁ : ∀ (h : ℝ), MolecularDynamics.IsTextbookSymplecticEquiv (G₁ h))
  (hG₂ : ∀ (h : ℝ), MolecularDynamics.IsTextbookSymplecticEquiv (G₂ h)) (h : ℝ) :
  MolecularDynamics.IsTextbookSymplecticEquiv (MolecularDynamics.textbookComposeMethods G₁ G₂ h)
MolecularDynamics.textbookSymmetricComposition_isSymplectic {Nc : ℕ}
  (G : ℝ → Equiv.Perm (MolecularDynamics.SymplecticCoordinates Nc))
  (hG : ∀ (h : ℝ), MolecularDynamics.IsTextbookSymplecticEquiv (G h)) (h : ℝ) :
  MolecularDynamics.IsTextbookSymplecticEquiv (MolecularDynamics.textbookSymmetricComposition G h)
MolecularDynamics.textbookConjugateMap.{u_1} {E : Type u_1} [TopologicalSpace E] (χ : E ≃ₜ E) (B : E → E) : E → E
MolecularDynamics.textbookConjugateMap_iterate.{u_1} {E : Type u_1} [TopologicalSpace E] (χ : E ≃ₜ E) (B : E → E)
  (n : ℕ) (z : E) : (MolecularDynamics.textbookConjugateMap χ B)^[n] z = χ.symm (B^[n] (χ z))
MolecularDynamics.textbook_conjugate_iterates.{u_1} {E : Type u_1} [TopologicalSpace E] (χ : E ≃ₜ E) (A B : E → E)
  (hA : A = MolecularDynamics.textbookConjugateMap χ B) (n : ℕ) : A^[n] = MolecularDynamics.textbookConjugateMap χ B^[n]
MolecularDynamics.textbook_conjugate_iterates_tendsto_iff.{u_1} {E : Type u_1} [TopologicalSpace E] (χ : E ≃ₜ E)
  (A B : E → E) (hA : A = MolecularDynamics.textbookConjugateMap χ B) (z₀ zStar : E) :
  Filter.Tendsto (fun n => A^[n] z₀) Filter.atTop (nhds zStar) ↔
    Filter.Tendsto (fun n => B^[n] (χ z₀)) Filter.atTop (nhds (χ zStar))
MolecularDynamics.textbookProcessedMethod.{u_1} {E : Type u_1} [TopologicalSpace E] (χ : ℝ → E ≃ₜ E) (B : ℝ → E → E)
  (h : ℝ) : E → E
MolecularDynamics.textbookProcessedIterate.{u_1} {E : Type u_1} [TopologicalSpace E] (χ : ℝ → E ≃ₜ E) (B : ℝ → E → E)
  (h : ℝ) (z₀ : E) (n : ℕ) : E
MolecularDynamics.textbookProcessedIterate_eq.{u_1} {E : Type u_1} [TopologicalSpace E] (χ : ℝ → E ≃ₜ E) (B : ℝ → E → E)
  (h : ℝ) (z₀ : E) (n : ℕ) :
  MolecularDynamics.textbookProcessedIterate χ B h z₀ n =
    MolecularDynamics.oneStepIterate (MolecularDynamics.textbookProcessedMethod χ B) h z₀ n
MolecularDynamics.textbookProcessedIterate_eq_of_conjugacy.{u_1} {E : Type u_1} [TopologicalSpace E] (χ : ℝ → E ≃ₜ E)
  (B G : ℝ → E → E) (hG : ∀ (h : ℝ), G h = MolecularDynamics.textbookProcessedMethod χ B h) (h : ℝ) (z₀ : E) (n : ℕ) :
  MolecularDynamics.textbookProcessedIterate χ B h z₀ n = MolecularDynamics.oneStepIterate G h z₀ n
MolecularDynamics.textbookProcessedMaxError.{u_1} {E : Type u_1} [NormedAddCommGroup E] (χ : ℝ → E ≃ₜ E) (B : ℝ → E → E)
  (h : ℝ) (γ : ℝ → E) (ν : ℕ) : ℝ
MolecularDynamics.textbookProcessedMaxError_eq_of_conjugacy.{u_1} {E : Type u_1} [NormedAddCommGroup E] (χ : ℝ → E ≃ₜ E)
  (B G : ℝ → E → E) (hG : ∀ (h : ℝ), G h = MolecularDynamics.textbookProcessedMethod χ B h) (h : ℝ) (γ : ℝ → E)
  (ν : ℕ) : MolecularDynamics.textbookProcessedMaxError χ B h γ ν = MolecularDynamics.oneStepMaxError G h γ ν
MolecularDynamics.textbookLieDerivative.{u_1} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E] (f : E → E)
  (φ : E → ℝ) (z : E) : ℝ
MolecularDynamics.hasDerivWithinAt_textbookLieDerivative.{u_1} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E]
  (f : E → E) (φ : E → ℝ) (γ : ℝ → E) (s : Set ℝ) (t : ℝ) (hφ : DifferentiableAt ℝ φ (γ t))
  (hγ : HasDerivWithinAt γ (f (γ t)) s t) :
  HasDerivWithinAt (fun u => φ (γ u)) (MolecularDynamics.textbookLieDerivative f φ (γ t)) s t
MolecularDynamics.hasDerivAt_textbookLieDerivative.{u_1} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E]
  (f : E → E) (φ : E → ℝ) (γ : ℝ → E) (t : ℝ) (hφ : DifferentiableAt ℝ φ (γ t)) (hγ : HasDerivAt γ (f (γ t)) t) :
  HasDerivAt (fun u => φ (γ u)) (MolecularDynamics.textbookLieDerivative f φ (γ t)) t
MolecularDynamics.contDiff_textbookLieDerivative.{u_1} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E]
  (f : E → E) (φ : E → ℝ) (hf : ContDiff ℝ 1 f) (hφ : ContDiff ℝ 2 φ) :
  ContDiff ℝ 1 (MolecularDynamics.textbookLieDerivative f φ)
MolecularDynamics.hasDerivAt_textbookLieDerivative_second.{u_1} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E]
  (f : E → E) (φ : E → ℝ) (γ : ℝ → E) (hf : ContDiff ℝ 1 f) (hφ : ContDiff ℝ 2 φ)
  (hγ : ∀ (t : ℝ), HasDerivAt γ (f (γ t)) t) (t : ℝ) :
  HasDerivAt (fun u => deriv (fun v => φ (γ v)) u)
    (MolecularDynamics.textbookLieDerivative f (MolecularDynamics.textbookLieDerivative f φ) (γ t)) t
MolecularDynamics.textbookLieDerivative_field_add.{u_1} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E]
  (f g : E → E) (φ : E → ℝ) (z : E) :
  MolecularDynamics.textbookLieDerivative (fun x => f x + g x) φ z =
    MolecularDynamics.textbookLieDerivative f φ z + MolecularDynamics.textbookLieDerivative g φ z
MolecularDynamics.textbookPoissonBracket {Nc : ℕ} (F G : MolecularDynamics.SymplecticCoordinates Nc → ℝ)
  (z : MolecularDynamics.SymplecticCoordinates Nc) : ℝ
MolecularDynamics.textbookPoissonBracket_coordinates {Nc : ℕ} (F G : MolecularDynamics.SymplecticCoordinates Nc → ℝ)
  (z : MolecularDynamics.SymplecticCoordinates Nc) :
  MolecularDynamics.textbookPoissonBracket F G z =
    ∑ i,
      ((fderiv ℝ F z) (Pi.single (Sum.inl i) 1) * (fderiv ℝ G z) (Pi.single (Sum.inr i) 1) -
        (fderiv ℝ G z) (Pi.single (Sum.inl i) 1) * (fderiv ℝ F z) (Pi.single (Sum.inr i) 1))
MolecularDynamics.textbookPoissonBracket_skew {Nc : ℕ} (F G : MolecularDynamics.SymplecticCoordinates Nc → ℝ)
  (z : MolecularDynamics.SymplecticCoordinates Nc) :
  MolecularDynamics.textbookPoissonBracket F G z = -MolecularDynamics.textbookPoissonBracket G F z
MolecularDynamics.textbookPoissonBracket_self {Nc : ℕ} (F : MolecularDynamics.SymplecticCoordinates Nc → ℝ)
  (z : MolecularDynamics.SymplecticCoordinates Nc) : MolecularDynamics.textbookPoissonBracket F F z = 0
MolecularDynamics.textbookPoissonBracket_linear_right {Nc : ℕ} (F G H : MolecularDynamics.SymplecticCoordinates Nc → ℝ)
  (α β : ℝ) (z : MolecularDynamics.SymplecticCoordinates Nc) (hG : DifferentiableAt ℝ G z)
  (hH : DifferentiableAt ℝ H z) :
  MolecularDynamics.textbookPoissonBracket F (fun x => α * G x + β * H x) z =
    α * MolecularDynamics.textbookPoissonBracket F G z + β * MolecularDynamics.textbookPoissonBracket F H z
MolecularDynamics.textbookPoissonBracket_jacobi {Nc : ℕ} (F G H : MolecularDynamics.SymplecticCoordinates Nc → ℝ)
  (z : MolecularDynamics.SymplecticCoordinates Nc) (hF : ContDiffAt ℝ 2 F z) (hG : ContDiffAt ℝ 2 G z)
  (hH : ContDiffAt ℝ 2 H z) :
  MolecularDynamics.textbookPoissonBracket F (MolecularDynamics.textbookPoissonBracket G H) z +
        MolecularDynamics.textbookPoissonBracket H (MolecularDynamics.textbookPoissonBracket F G) z +
      MolecularDynamics.textbookPoissonBracket G (MolecularDynamics.textbookPoissonBracket H F) z =
    0
MolecularDynamics.textbookLieDerivative_hamiltonian_eq_poisson {Nc : ℕ}
  (F H : MolecularDynamics.SymplecticCoordinates Nc → ℝ) :
  MolecularDynamics.textbookLieDerivative (MolecularDynamics.textbookHamiltonianVectorField H) F =
    MolecularDynamics.textbookPoissonBracket F H
MolecularDynamics.hasDerivWithinAt_textbookPoissonBracket {Nc : ℕ}
  (F H : MolecularDynamics.SymplecticCoordinates Nc → ℝ) (γ : ℝ → MolecularDynamics.SymplecticCoordinates Nc)
  (s : Set ℝ) (t : ℝ) (hF : DifferentiableAt ℝ F (γ t))
  (hγ : HasDerivWithinAt γ (MolecularDynamics.textbookHamiltonianVectorField H (γ t)) s t) :
  HasDerivWithinAt (fun u => F (γ u)) (MolecularDynamics.textbookPoissonBracket F H (γ t)) s t
MolecularDynamics.textbookHamiltonian_energy_const_on_Icc {Nc : ℕ} (H : MolecularDynamics.SymplecticCoordinates Nc → ℝ)
  (γ : ℝ → MolecularDynamics.SymplecticCoordinates Nc) (τ : ℝ) (hH : ∀ t ∈ Set.Icc 0 τ, DifferentiableAt ℝ H (γ t))
  (hγ :
    ∀ t ∈ Set.Icc 0 τ, HasDerivWithinAt γ (MolecularDynamics.textbookHamiltonianVectorField H (γ t)) (Set.Icc 0 τ) t)
  (t : ℝ) : t ∈ Set.Icc 0 τ → H (γ t) = H (γ 0)
MolecularDynamics.textbookPoissonBracket_linear_left {Nc : ℕ} (F G H : MolecularDynamics.SymplecticCoordinates Nc → ℝ)
  (α β : ℝ) (z : MolecularDynamics.SymplecticCoordinates Nc) (hF : DifferentiableAt ℝ F z)
  (hH : DifferentiableAt ℝ H z) :
  MolecularDynamics.textbookPoissonBracket (fun x => α * F x + β * H x) G z =
    α * MolecularDynamics.textbookPoissonBracket F G z + β * MolecularDynamics.textbookPoissonBracket H G z
MolecularDynamics.textbookHamiltonianLieDerivative_add {Nc : ℕ}
  (F H₁ H₂ : MolecularDynamics.SymplecticCoordinates Nc → ℝ) (z : MolecularDynamics.SymplecticCoordinates Nc)
  (hH₁ : DifferentiableAt ℝ H₁ z) (hH₂ : DifferentiableAt ℝ H₂ z) :
  MolecularDynamics.textbookLieDerivative (MolecularDynamics.textbookHamiltonianVectorField fun x => H₁ x + H₂ x) F z =
    MolecularDynamics.textbookLieDerivative (MolecularDynamics.textbookHamiltonianVectorField H₁) F z +
      MolecularDynamics.textbookLieDerivative (MolecularDynamics.textbookHamiltonianVectorField H₂) F z
MolecularDynamics.textbookHamiltonianLieDerivative_commutator {Nc : ℕ}
  (F H₁ H₂ : MolecularDynamics.SymplecticCoordinates Nc → ℝ) (z : MolecularDynamics.SymplecticCoordinates Nc)
  (hF : ContDiffAt ℝ 2 F z) (hH₁ : ContDiffAt ℝ 2 H₁ z) (hH₂ : ContDiffAt ℝ 2 H₂ z) :
  MolecularDynamics.textbookLieDerivative (MolecularDynamics.textbookHamiltonianVectorField H₁)
        (MolecularDynamics.textbookLieDerivative (MolecularDynamics.textbookHamiltonianVectorField H₂) F) z -
      MolecularDynamics.textbookLieDerivative (MolecularDynamics.textbookHamiltonianVectorField H₂)
        (MolecularDynamics.textbookLieDerivative (MolecularDynamics.textbookHamiltonianVectorField H₁) F) z =
    MolecularDynamics.textbookLieDerivative
      (MolecularDynamics.textbookHamiltonianVectorField (MolecularDynamics.textbookPoissonBracket H₂ H₁)) F z
MolecularDynamics.textbookFormalOperatorExponential.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R] (A : R) : PowerSeries R
MolecularDynamics.textbookFormalOperatorExponential_coeff.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R] (A : R) (n : ℕ) :
  (PowerSeries.coeff n) (MolecularDynamics.textbookFormalOperatorExponential A) = (1 / ↑n.factorial) • A ^ n
MolecularDynamics.textbookFormalOperatorProduct_coeff_zero.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R] (A B : R) :
  (PowerSeries.coeff 0)
      (MolecularDynamics.textbookFormalOperatorExponential A * MolecularDynamics.textbookFormalOperatorExponential B) =
    1
MolecularDynamics.textbookFormalOperatorProduct_coeff_one.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R] (A B : R) :
  (PowerSeries.coeff 1)
      (MolecularDynamics.textbookFormalOperatorExponential A * MolecularDynamics.textbookFormalOperatorExponential B) =
    A + B
MolecularDynamics.textbookFormalOperatorProduct_coeff_two.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R] (A B : R) :
  (PowerSeries.coeff 2)
      (MolecularDynamics.textbookFormalOperatorExponential A * MolecularDynamics.textbookFormalOperatorExponential B) =
    (1 / 2) • A ^ 2 + A * B + (1 / 2) • B ^ 2
MolecularDynamics.textbookFormalOperatorProduct_coeff_three.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R] (A B : R) :
  (PowerSeries.coeff 3)
      (MolecularDynamics.textbookFormalOperatorExponential A * MolecularDynamics.textbookFormalOperatorExponential B) =
    (1 / 6) • A ^ 3 + (1 / 2) • (A ^ 2 * B) + (1 / 2) • (A * B ^ 2) + (1 / 6) • B ^ 3
MolecularDynamics.textbookFormalOperatorDifference_coeff_two.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R] (A B : R) :
  (PowerSeries.coeff 2)
      (MolecularDynamics.textbookFormalOperatorExponential A * MolecularDynamics.textbookFormalOperatorExponential B -
        MolecularDynamics.textbookFormalOperatorExponential (A + B)) =
    (1 / 2) • (A * B - B * A)
MolecularDynamics.textbookFormalOperatorDifference_coeff_three.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R] (A B : R) :
  (PowerSeries.coeff 3)
      (MolecularDynamics.textbookFormalOperatorExponential A * MolecularDynamics.textbookFormalOperatorExponential B -
        MolecularDynamics.textbookFormalOperatorExponential (A + B)) =
    (1 / 6) • (2 • (A * B ^ 2) + 2 • (A ^ 2 * B) - B * A ^ 2 - B * A * B - B ^ 2 * A - A * B * A)
MolecularDynamics.textbookFormalZeroConstant_power_coeff_zero.{u_1} {R : Type u_1} [Ring R]
  (P : { P // PowerSeries.constantCoeff P = 0 }) (j n : ℕ) (hjn : j < n) : (PowerSeries.coeff j) (↑P ^ n) = 0
MolecularDynamics.textbookFormalZeroConstantExponential.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R]
  (P : { P // PowerSeries.constantCoeff P = 0 }) : PowerSeries R
MolecularDynamics.textbookFormalZeroConstantExponential_coeff_stabilizes.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R]
  (P : { P // PowerSeries.constantCoeff P = 0 }) (j N : ℕ) (hjN : j < N) :
  (PowerSeries.coeff j) (MolecularDynamics.textbookFormalZeroConstantExponential P) =
    ∑ n ∈ Finset.range N, (1 / ↑n.factorial) • (PowerSeries.coeff j) (↑P ^ n)
MolecularDynamics.textbookFormalModifiedExponential.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R] (A B C : R) :
  PowerSeries R
MolecularDynamics.textbookFormalModifiedExponential_coeff_zero.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R] (A B C : R) :
  (PowerSeries.coeff 0) (MolecularDynamics.textbookFormalModifiedExponential A B C) = 1
MolecularDynamics.textbookFormalModifiedExponential_coeff_one.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R] (A B C : R) :
  (PowerSeries.coeff 1) (MolecularDynamics.textbookFormalModifiedExponential A B C) = A + B
MolecularDynamics.textbookFormalModifiedExponential_coeff_two.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R] (A B C : R) :
  (PowerSeries.coeff 2) (MolecularDynamics.textbookFormalModifiedExponential A B C) = C + (1 / 2) • (A + B) ^ 2
MolecularDynamics.textbookFormalModifiedExponential_matches_product.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R]
  (A B : R) (n : ℕ) (hn : n < 3) :
  (PowerSeries.coeff n)
      (MolecularDynamics.textbookFormalOperatorExponential A * MolecularDynamics.textbookFormalOperatorExponential B) =
    (PowerSeries.coeff n) (MolecularDynamics.textbookFormalModifiedExponential A B ((1 / 2) • (A * B - B * A)))
