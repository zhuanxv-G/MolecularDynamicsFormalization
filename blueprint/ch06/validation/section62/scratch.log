MolecularDynamics.textbookBrownianGenerator_eq_sde_coefficients {Nc : ℕ} (m : Fin Nc → ℝ) (hm : ∀ (i : Fin Nc), 0 < m i)
  (U : (Fin Nc → ℝ) → ℝ) (β : ℝ) (hβ : 0 < β) (f : (Fin Nc → ℝ) → ℝ) (q : Fin Nc → ℝ) :
  MolecularDynamics.textbookBrownianGenerator m U β f q =
