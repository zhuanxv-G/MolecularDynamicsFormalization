MolecularDynamics.oneStepIterate_succ.{u_1} {E : Type u_1} (G : ℝ → E → E) (h : ℝ) (z₀ : E) (n : ℕ) :
  MolecularDynamics.oneStepIterate G h z₀ (n + 1) = G h (MolecularDynamics.oneStepIterate G h z₀ n)
MolecularDynamics.oneStepMaxError.{u_1} {E : Type u_1} [NormedAddCommGroup E] (G : ℝ → E → E) (h : ℝ) (γ : ℝ → E)
  (ν : ℕ) : ℝ
