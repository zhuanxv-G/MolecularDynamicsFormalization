MolecularDynamics.textbookBrownianTheorem6_1_smooth_spectral_parts {Nc : ℕ} (m : Fin Nc → ℝ)
  (hm : ∀ (i : Fin Nc), 0 < m i) (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (hβ : 0 < β) (hNc : 0 < Nc) :
  IsSelfAdjoint (MolecularDynamics.A✝ m hm U hU hPU β hβ) ∧
    Module.finrank ℂ ↥(MolecularDynamics.A✝ m hm U hU hPU β hβ).ker = 1 ∧
      0 < MolecularDynamics.textbookBrownianGibbsCoercivityRate m U hU hPU β ∧
        ∃ ℓ b,
          ℓ 0 = 0 ∧
            Antitone ℓ ∧
              Filter.Tendsto ℓ Filter.atTop Filter.atBot ∧
                (∀ (n : ℕ), n ≠ 0 → ℓ n ≤ -MolecularDynamics.textbookBrownianGibbsCoercivityRate m U hU hPU β) ∧
                  b 0 = (MolecularDynamics.J✝ U β) (MolecularDynamics.e✝ U hU hPU β) ∧
                    (∀ (n : ℕ), (b n, ↑(ℓ n) • b n) ∈ (MolecularDynamics.A✝ m hm U hU hPU β hβ).graph) ∧
                      (MolecularDynamics.textbookBrownianGibbsGeneratorComplexSpectrum m hm U hU hPU β hβ =
                          Set.range fun n => ↑(ℓ n)) ∧
                        ∀ (z : ↥(MolecularDynamics.GibbsComplex✝ U β)), HasSum (fun n => inner ℂ (b n) z • b n) z
