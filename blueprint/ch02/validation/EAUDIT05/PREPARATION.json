    "MD-2.2.3-Consistency": "def consistency {n : ℕ} (G F : ℝ → Q n → Q n) (γ : ℝ → Q n) (τ : ℝ) (p : ℕ) : Prop :=\n  ∃ K ≥ 0, ∃ δ > 0, ∀ t ∈ Icc 0 τ, ∀ h ∈ Ioo 0 δ,\n    ‖F h (γ t)-G h (γ t)‖ ≤ K*h^(p+1)"
