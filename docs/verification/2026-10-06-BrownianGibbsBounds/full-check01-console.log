  (γ : ℝ) (z : MolecularDynamics.textbookLangevinPhase Nc) :
  HasDerivAt
    (fun t => MolecularDynamics.textbookLangevinHamiltonian U (z + t • MolecularDynamics.textbookLangevinDrift U γ z))
    (-γ * ∑ i, z.2 i ^ 2) 0
