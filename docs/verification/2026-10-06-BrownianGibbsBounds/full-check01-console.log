  (z : MolecularDynamics.textbookThermostatPhase Nc) :
  (MolecularDynamics.textbookThermostatF A) z = (z.2, -A.mulVec z.1)
MolecularDynamics.textbookThermostatG_apply (Nc : ℕ) (z : MolecularDynamics.textbookThermostatPhase Nc) :
  (MolecularDynamics.textbookThermostatG Nc) z = (0, z.2)
MolecularDynamics.textbookThermostatC_apply {Nc : ℕ} (A : Matrix (Fin Nc) (Fin Nc) ℝ) (k : ℕ)
  (z : MolecularDynamics.textbookThermostatPhase Nc) :
  (MolecularDynamics.textbookThermostatC A k) z = ((A ^ k).mulVec z.2, (A ^ (k + 1)).mulVec z.1)
MolecularDynamics.textbookThermostatD_apply {Nc : ℕ} (A : Matrix (Fin Nc) (Fin Nc) ℝ) (k : ℕ)
  (z : MolecularDynamics.textbookThermostatPhase Nc) :
  (MolecularDynamics.textbookThermostatD A k) z = ((A ^ (k + 1)).mulVec z.1, -(A ^ (k + 1)).mulVec z.2)
