MolecularDynamics.contDiff_textbookPotentialForce {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ 2 U) :
  ContDiff ℝ 1 (MolecularDynamics.textbookPotentialForce U)
MolecularDynamics.textbookPotentialForce_matrix_isSymm {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (q : Fin Nc → ℝ)
  (hU : ContDiff ℝ 2 U) : (LinearMap.toMatrix' ↑(fderiv ℝ (MolecularDynamics.textbookPotentialForce U) q)).IsSymm
MolecularDynamics.textbookMomentumKick {Nc : ℕ} (F : (Fin Nc → ℝ) → Fin Nc → ℝ) (h : ℝ)
  (z : MolecularDynamics.SymplecticCoordinates Nc) : MolecularDynamics.SymplecticCoordinates Nc
MolecularDynamics.textbookPositionDrift {Nc : ℕ} (m : Fin Nc → ℝ) (h : ℝ)
  (z : MolecularDynamics.SymplecticCoordinates Nc) : MolecularDynamics.SymplecticCoordinates Nc
MolecularDynamics.textbookJacobian_momentumKick {Nc : ℕ} (F : (Fin Nc → ℝ) → Fin Nc → ℝ) (h : ℝ)
  (z : MolecularDynamics.SymplecticCoordinates Nc) (hF : ContDiff ℝ 1 F) :
  MolecularDynamics.textbookJacobian (MolecularDynamics.textbookMomentumKick F h) z =
    Matrix.fromBlocks 1 0 (h • LinearMap.toMatrix' ↑(fderiv ℝ F ((MolecularDynamics.textbookPositionProjection Nc) z)))
      1
MolecularDynamics.contDiff_textbookMomentumKick {Nc : ℕ} (F : (Fin Nc → ℝ) → Fin Nc → ℝ) (h : ℝ) (hF : ContDiff ℝ 1 F) :
  ContDiff ℝ 1 (MolecularDynamics.textbookMomentumKick F h)
MolecularDynamics.textbookJacobian_positionDrift {Nc : ℕ} (m : Fin Nc → ℝ) (h : ℝ)
  (z : MolecularDynamics.SymplecticCoordinates Nc) :
  MolecularDynamics.textbookJacobian (MolecularDynamics.textbookPositionDrift m h) z =
    Matrix.fromBlocks 1 (Matrix.diagonal fun i => h * (m i)⁻¹) 0 1
MolecularDynamics.textbookPositionDrift_isSymplectic {Nc : ℕ} (m : Fin Nc → ℝ) (h : ℝ) :
  MolecularDynamics.IsTextbookSymplecticMap (MolecularDynamics.textbookPositionDrift m h)
MolecularDynamics.textbookPotentialKick_isSymplectic {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (h : ℝ) (hU : ContDiff ℝ 2 U) :
  MolecularDynamics.IsTextbookSymplecticMap
    (MolecularDynamics.textbookMomentumKick (MolecularDynamics.textbookPotentialForce U) h)
MolecularDynamics.textbookSymplecticEuler {Nc : ℕ} (m : Fin Nc → ℝ) (U : (Fin Nc → ℝ) → ℝ) (h : ℝ) :
  MolecularDynamics.SymplecticCoordinates Nc → MolecularDynamics.SymplecticCoordinates Nc
MolecularDynamics.textbookSymplecticEuler_position {Nc : ℕ} (m : Fin Nc → ℝ) (U : (Fin Nc → ℝ) → ℝ) (h : ℝ)
  (z : MolecularDynamics.SymplecticCoordinates Nc) (i : Fin Nc) :
  MolecularDynamics.textbookSymplecticEuler m U h z (Sum.inl i) =
    z (Sum.inl i) +
      h * (m i)⁻¹ *
        (z (Sum.inr i) +
          h * MolecularDynamics.textbookPotentialForce U ((MolecularDynamics.textbookPositionProjection Nc) z) i)
MolecularDynamics.textbookSymplecticEuler_momentum {Nc : ℕ} (m : Fin Nc → ℝ) (U : (Fin Nc → ℝ) → ℝ) (h : ℝ)
  (z : MolecularDynamics.SymplecticCoordinates Nc) (i : Fin Nc) :
  MolecularDynamics.textbookSymplecticEuler m U h z (Sum.inr i) =
    z (Sum.inr i) +
      h * MolecularDynamics.textbookPotentialForce U ((MolecularDynamics.textbookPositionProjection Nc) z) i
MolecularDynamics.textbookSymplecticEuler_isSymplectic {Nc : ℕ} (m : Fin Nc → ℝ) (U : (Fin Nc → ℝ) → ℝ) (h : ℝ)
  (hU : ContDiff ℝ 2 U) : MolecularDynamics.IsTextbookSymplecticMap (MolecularDynamics.textbookSymplecticEuler m U h)
MolecularDynamics.textbookPositionProjection_momentumKick {Nc : ℕ} (F : (Fin Nc → ℝ) → Fin Nc → ℝ) (h : ℝ)
  (z : MolecularDynamics.SymplecticCoordinates Nc) :
  (MolecularDynamics.textbookPositionProjection Nc) (MolecularDynamics.textbookMomentumKick F h z) =
    (MolecularDynamics.textbookPositionProjection Nc) z
MolecularDynamics.textbookMomentumKick_neg_cancel {Nc : ℕ} (F : (Fin Nc → ℝ) → Fin Nc → ℝ) (h : ℝ)
  (z : MolecularDynamics.SymplecticCoordinates Nc) :
  MolecularDynamics.textbookMomentumKick F (-h) (MolecularDynamics.textbookMomentumKick F h z) = z
MolecularDynamics.textbookPositionDrift_neg_cancel {Nc : ℕ} (m : Fin Nc → ℝ) (h : ℝ)
  (z : MolecularDynamics.SymplecticCoordinates Nc) :
  MolecularDynamics.textbookPositionDrift m (-h) (MolecularDynamics.textbookPositionDrift m h z) = z
