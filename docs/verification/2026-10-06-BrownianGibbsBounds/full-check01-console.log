MolecularDynamics.textbookLangevinLyapunov_physical_diffusion_coefficient (γ β : ℝ) (hγ : 0 < γ) (hβ : 0 < β) :
  √(2 * γ * β⁻¹) ^ 2 / 2 = γ * β⁻¹
MolecularDynamics.textbookLangevinPeriodicHamiltonianPower_physical_lyapunov {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ)
  (hU : ContDiff ℝ (↑⊤) U) (hP : MolecularDynamics.textbookUnitPeriodicPotential U) (hL : ∀ (q : Fin Nc → ℝ), 1 ≤ U q)
  (γ β : ℝ) (hγ : 0 < γ) (hβ : 0 < β) (l : ℕ) (hl : 1 ≤ l) :
  0 < γ * ↑l ∧
    √(2 * γ * β⁻¹) ^ 2 / 2 = γ * β⁻¹ ∧
      (∀ (z : MolecularDynamics.textbookLangevinPeriodicPhase Nc),
          0 < MolecularDynamics.textbookLangevinPeriodicHamiltonianPower U l z) ∧
        (∀ (R : ℝ), IsCompact {z | MolecularDynamics.textbookLangevinPeriodicHamiltonianPower U l z ≤ R}) ∧
          Filter.Tendsto (MolecularDynamics.textbookLangevinPeriodicHamiltonianPower U l)
              (Filter.cocompact (MolecularDynamics.textbookLangevinPeriodicPhase Nc)) Filter.atTop ∧
            ∃ δ,
              0 < δ ∧
                ∀ (z : MolecularDynamics.textbookLangevinPeriodicPhase Nc),
                  MolecularDynamics.textbookLangevinPeriodicDifferentialOperator U γ (√(2 * γ * β⁻¹))
                      (MolecularDynamics.textbookLangevinPeriodicHamiltonianPower U l) z ≤
