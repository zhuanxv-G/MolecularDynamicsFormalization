MolecularDynamics.SymplecticCoordinates (Nc : ℕ) : Type
MolecularDynamics.SymplecticCoordinateMatrix (Nc : ℕ) : Type
MolecularDynamics.textbookJ (Nc : ℕ) : MolecularDynamics.SymplecticCoordinateMatrix Nc
MolecularDynamics.textbookJ_eq_neg_mathlibJ (Nc : ℕ) : MolecularDynamics.textbookJ Nc = -Matrix.J (Fin Nc) ℝ
MolecularDynamics.textbookJ_transpose (Nc : ℕ) :
  Matrix.transpose (MolecularDynamics.textbookJ Nc) = -MolecularDynamics.textbookJ Nc
MolecularDynamics.textbookJ_squared (Nc : ℕ) : MolecularDynamics.textbookJ Nc * MolecularDynamics.textbookJ Nc = -1
MolecularDynamics.textbookDq {Nc : ℕ} (i : Fin Nc) : MolecularDynamics.SymplecticCoordinates Nc →ₗ[ℝ] ℝ
MolecularDynamics.textbookDp {Nc : ℕ} (i : Fin Nc) : MolecularDynamics.SymplecticCoordinates Nc →ₗ[ℝ] ℝ
MolecularDynamics.textbookDq_apply {Nc : ℕ} (i : Fin Nc) (u : MolecularDynamics.SymplecticCoordinates Nc) :
  (MolecularDynamics.textbookDq i) u = u (Sum.inl i)
MolecularDynamics.textbookDp_apply {Nc : ℕ} (i : Fin Nc) (u : MolecularDynamics.SymplecticCoordinates Nc) :
  (MolecularDynamics.textbookDp i) u = u (Sum.inr i)
MolecularDynamics.textbookWedgeOneForms {Nc : ℕ} (α β : MolecularDynamics.SymplecticCoordinates Nc →ₗ[ℝ] ℝ) :
  LinearMap.BilinForm ℝ (MolecularDynamics.SymplecticCoordinates Nc)
MolecularDynamics.textbookWedgeOneForms_apply {Nc : ℕ} (α β : MolecularDynamics.SymplecticCoordinates Nc →ₗ[ℝ] ℝ)
  (u v : MolecularDynamics.SymplecticCoordinates Nc) :
  ((MolecularDynamics.textbookWedgeOneForms α β) u) v = α u * β v - α v * β u
MolecularDynamics.textbookSymplecticForm (Nc : ℕ) : LinearMap.BilinForm ℝ (MolecularDynamics.SymplecticCoordinates Nc)
MolecularDynamics.textbookSymplecticForm_coordinates (Nc : ℕ) (u v : MolecularDynamics.SymplecticCoordinates Nc) :
  ((MolecularDynamics.textbookSymplecticForm Nc) u) v =
    ∑ i, (u (Sum.inl i) * v (Sum.inr i) - u (Sum.inr i) * v (Sum.inl i))
MolecularDynamics.textbookSymplecticForm_eq_sum_wedges (Nc : ℕ) :
  MolecularDynamics.textbookSymplecticForm Nc =
    ∑ i, MolecularDynamics.textbookWedgeOneForms (MolecularDynamics.textbookDq i) (MolecularDynamics.textbookDp i)
MolecularDynamics.textbookSymplecticForm_self (Nc : ℕ) (u : MolecularDynamics.SymplecticCoordinates Nc) :
  ((MolecularDynamics.textbookSymplecticForm Nc) u) u = 0
MolecularDynamics.textbookSymplecticForm_skew (Nc : ℕ) (u v : MolecularDynamics.SymplecticCoordinates Nc) :
  ((MolecularDynamics.textbookSymplecticForm Nc) v) u = -((MolecularDynamics.textbookSymplecticForm Nc) u) v
MolecularDynamics.textbookSymplecticPullback {Nc : ℕ} (A : MolecularDynamics.SymplecticCoordinateMatrix Nc) :
  LinearMap.BilinForm ℝ (MolecularDynamics.SymplecticCoordinates Nc)
MolecularDynamics.textbookSymplecticPullback_apply {Nc : ℕ} (A : MolecularDynamics.SymplecticCoordinateMatrix Nc)
  (u v : MolecularDynamics.SymplecticCoordinates Nc) :
  ((MolecularDynamics.textbookSymplecticPullback A) u) v =
    ((MolecularDynamics.textbookSymplecticForm Nc) (Matrix.mulVec A u)) (Matrix.mulVec A v)
MolecularDynamics.textbookSymplecticPullback_matrix {Nc : ℕ} (A : MolecularDynamics.SymplecticCoordinateMatrix Nc) :
  MolecularDynamics.textbookSymplecticPullback A =
    Matrix.toBilin' (Matrix.transpose A * MolecularDynamics.textbookJ Nc * A)
MolecularDynamics.IsTextbookSymplectic {Nc : ℕ} (A : MolecularDynamics.SymplecticCoordinateMatrix Nc) : Prop
MolecularDynamics.isTextbookSymplectic_iff_pullback {Nc : ℕ} (A : MolecularDynamics.SymplecticCoordinateMatrix Nc) :
  MolecularDynamics.IsTextbookSymplectic A ↔
    MolecularDynamics.textbookSymplecticPullback A = MolecularDynamics.textbookSymplecticForm Nc
MolecularDynamics.isTextbookSymplectic_iff_preserves_form {Nc : ℕ}
  (A : MolecularDynamics.SymplecticCoordinateMatrix Nc) :
  MolecularDynamics.IsTextbookSymplectic A ↔
    ∀ (u v : MolecularDynamics.SymplecticCoordinates Nc),
      ((MolecularDynamics.textbookSymplecticForm Nc) (Matrix.mulVec A u)) (Matrix.mulVec A v) =
        ((MolecularDynamics.textbookSymplecticForm Nc) u) v
MolecularDynamics.isTextbookSymplectic_iff_mathlib {Nc : ℕ} (A : MolecularDynamics.SymplecticCoordinateMatrix Nc) :
  MolecularDynamics.IsTextbookSymplectic A ↔ A ∈ Matrix.symplecticGroup (Fin Nc) ℝ
MolecularDynamics.isTextbookSymplectic_one (Nc : ℕ) : MolecularDynamics.IsTextbookSymplectic 1
MolecularDynamics.IsTextbookSymplectic.mul {Nc : ℕ} {A B : MolecularDynamics.SymplecticCoordinateMatrix Nc}
  (hA : MolecularDynamics.IsTextbookSymplectic A) (hB : MolecularDynamics.IsTextbookSymplectic B) :
  MolecularDynamics.IsTextbookSymplectic (A * B)
MolecularDynamics.IsTextbookSymplectic.det_eq_one {Nc : ℕ} {A : MolecularDynamics.SymplecticCoordinateMatrix Nc}
  (hA : MolecularDynamics.IsTextbookSymplectic A) : Matrix.det A = 1
MolecularDynamics.IsTextbookSymplectic.det_square {Nc : ℕ} {A : MolecularDynamics.SymplecticCoordinateMatrix Nc}
  (hA : MolecularDynamics.IsTextbookSymplectic A) : Matrix.det A ^ 2 = 1
MolecularDynamics.IsTextbookSymplectic.abs_det {Nc : ℕ} {A : MolecularDynamics.SymplecticCoordinateMatrix Nc}
  (hA : MolecularDynamics.IsTextbookSymplectic A) : |Matrix.det A| = 1
MolecularDynamics.IsTextbookSymplectic.inv {Nc : ℕ} {A : MolecularDynamics.SymplecticCoordinateMatrix Nc}
  (hA : MolecularDynamics.IsTextbookSymplectic A) : MolecularDynamics.IsTextbookSymplectic A⁻¹
MolecularDynamics.IsTextbookSymplectic.inv_formula {Nc : ℕ} {A : MolecularDynamics.SymplecticCoordinateMatrix Nc}
  (hA : MolecularDynamics.IsTextbookSymplectic A) :
  A⁻¹ = -MolecularDynamics.textbookJ Nc * Matrix.transpose A * MolecularDynamics.textbookJ Nc
MolecularDynamics.textbookJacobian {Nc : ℕ}
  (Φ : MolecularDynamics.SymplecticCoordinates Nc → MolecularDynamics.SymplecticCoordinates Nc)
  (z : MolecularDynamics.SymplecticCoordinates Nc) : MolecularDynamics.SymplecticCoordinateMatrix Nc
MolecularDynamics.textbookJacobian_entry {Nc : ℕ}
  (Φ : MolecularDynamics.SymplecticCoordinates Nc → MolecularDynamics.SymplecticCoordinates Nc)
  (z : MolecularDynamics.SymplecticCoordinates Nc) (i j : Fin Nc ⊕ Fin Nc) :
  MolecularDynamics.textbookJacobian Φ z i j = (fderiv ℝ Φ z) (Pi.single j 1) i
MolecularDynamics.textbookJacobian_mulVec {Nc : ℕ}
  (Φ : MolecularDynamics.SymplecticCoordinates Nc → MolecularDynamics.SymplecticCoordinates Nc)
  (z u : MolecularDynamics.SymplecticCoordinates Nc) :
  Matrix.mulVec (MolecularDynamics.textbookJacobian Φ z) u = (fderiv ℝ Φ z) u
MolecularDynamics.textbookJacobian_id (Nc : ℕ) (z : MolecularDynamics.SymplecticCoordinates Nc) :
  MolecularDynamics.textbookJacobian id z = 1
MolecularDynamics.textbookJacobian_comp {Nc : ℕ}
  (Φ Ψ : MolecularDynamics.SymplecticCoordinates Nc → MolecularDynamics.SymplecticCoordinates Nc)
  (hΦ : Differentiable ℝ Φ) (hΨ : Differentiable ℝ Ψ) (z : MolecularDynamics.SymplecticCoordinates Nc) :
  MolecularDynamics.textbookJacobian (Φ ∘ Ψ) z =
    MolecularDynamics.textbookJacobian Φ (Ψ z) * MolecularDynamics.textbookJacobian Ψ z
MolecularDynamics.IsTextbookSymplecticMap {Nc : ℕ}
  (Φ : MolecularDynamics.SymplecticCoordinates Nc → MolecularDynamics.SymplecticCoordinates Nc) : Prop
MolecularDynamics.isTextbookSymplecticMap_iff_preserves_form {Nc : ℕ}
  (Φ : MolecularDynamics.SymplecticCoordinates Nc → MolecularDynamics.SymplecticCoordinates Nc) :
  MolecularDynamics.IsTextbookSymplecticMap Φ ↔
    ContDiff ℝ 1 Φ ∧
      ∀ (z u v : MolecularDynamics.SymplecticCoordinates Nc),
        ((MolecularDynamics.textbookSymplecticForm Nc) ((fderiv ℝ Φ z) u)) ((fderiv ℝ Φ z) v) =
          ((MolecularDynamics.textbookSymplecticForm Nc) u) v
MolecularDynamics.isTextbookSymplecticMap_id (Nc : ℕ) : MolecularDynamics.IsTextbookSymplecticMap id
MolecularDynamics.IsTextbookSymplecticMap.comp {Nc : ℕ}
  {Φ Ψ : MolecularDynamics.SymplecticCoordinates Nc → MolecularDynamics.SymplecticCoordinates Nc}
  (hΦ : MolecularDynamics.IsTextbookSymplecticMap Φ) (hΨ : MolecularDynamics.IsTextbookSymplecticMap Ψ) :
  MolecularDynamics.IsTextbookSymplecticMap (Φ ∘ Ψ)
MolecularDynamics.IsTextbookSymplecticMap.jacobian_det_eq_one {Nc : ℕ}
  {Φ : MolecularDynamics.SymplecticCoordinates Nc → MolecularDynamics.SymplecticCoordinates Nc}
  (hΦ : MolecularDynamics.IsTextbookSymplecticMap Φ) (z : MolecularDynamics.SymplecticCoordinates Nc) :
  Matrix.det (MolecularDynamics.textbookJacobian Φ z) = 1
MolecularDynamics.textbookJacobian_equiv_symm {Nc : ℕ} (e : Equiv.Perm (MolecularDynamics.SymplecticCoordinates Nc))
