  (he : MolecularDynamics.IsTextbookSymplecticEquiv e) (hf : MolecularDynamics.IsTextbookSymplecticEquiv f) :
  MolecularDynamics.IsTextbookSymplecticEquiv (e * f)
MolecularDynamics.IsTextbookSymplecticEquiv.symm {Nc : ℕ} {e : Equiv.Perm (MolecularDynamics.SymplecticCoordinates Nc)}
  (he : MolecularDynamics.IsTextbookSymplecticEquiv e) : MolecularDynamics.IsTextbookSymplecticEquiv (Equiv.symm e)
MolecularDynamics.textbookSymplecticDiffeomorphismGroup (Nc : ℕ) :
  Subgroup (Equiv.Perm (MolecularDynamics.SymplecticCoordinates Nc))
MolecularDynamics.textbookSymplecticDiffeomorphismGroup_mem_iff {Nc : ℕ}
  (e : Equiv.Perm (MolecularDynamics.SymplecticCoordinates Nc)) :
  e ∈ MolecularDynamics.textbookSymplecticDiffeomorphismGroup Nc ↔ MolecularDynamics.IsTextbookSymplecticEquiv e
