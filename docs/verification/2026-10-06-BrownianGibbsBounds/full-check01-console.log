  (ν : ℕ) : 0 ≤ MolecularDynamics.oneStepMaxError G h γ ν
MolecularDynamics.oneStepMaxError_le.{u_1} {E : Type u_1} [NormedAddCommGroup E] (G : ℝ → E → E) (h : ℝ) (γ : ℝ → E)
  (ν : ℕ) (B : ℝ) (hb : ∀ n ≤ ν, ‖MolecularDynamics.oneStepIterate G h (γ 0) n - γ (↑n * h)‖ ≤ B) :
  MolecularDynamics.oneStepMaxError G h γ ν ≤ B
MolecularDynamics.oneStep_error_recursion.{u_1} {E : Type u_1} [NormedAddCommGroup E] (G : ℝ → E → E) (γ : ℝ → E)
  (D : Set E) (h L K p : ℝ) (ν : ℕ) (hnum : ∀ n ≤ ν, MolecularDynamics.oneStepIterate G h (γ 0) n ∈ D)
  (hexact : ∀ n ≤ ν, γ (↑n * h) ∈ D) (hstable : ∀ u ∈ D, ∀ w ∈ D, ‖G h u - G h w‖ ≤ (1 + h * L) * ‖u - w‖)
  (hconsistent : ∀ n < ν, ‖G h (γ (↑n * h)) - γ (↑(n + 1) * h)‖ ≤ K * h ^ (p + 1)) (n : ℕ) (hn : n < ν) :
  ‖MolecularDynamics.oneStepIterate G h (γ 0) (n + 1) - γ (↑(n + 1) * h)‖ ≤
    (1 + h * L) * ‖MolecularDynamics.oneStepIterate G h (γ 0) n - γ (↑n * h)‖ + K * h ^ (p + 1)
MolecularDynamics.oneStep_error_bound.{u_1} {E : Type u_1} [NormedAddCommGroup E] (G : ℝ → E → E) (γ : ℝ → E)
  (D : Set E) {h L K p : ℝ} (ν : ℕ) (hh : 0 < h) (hL : 0 < L) (hK : 0 ≤ K)
  (hnum : ∀ n ≤ ν, MolecularDynamics.oneStepIterate G h (γ 0) n ∈ D) (hexact : ∀ n ≤ ν, γ (↑n * h) ∈ D)
  (hstable : ∀ u ∈ D, ∀ w ∈ D, ‖G h u - G h w‖ ≤ (1 + h * L) * ‖u - w‖)
  (hconsistent : ∀ n < ν, ‖G h (γ (↑n * h)) - γ (↑(n + 1) * h)‖ ≤ K * h ^ (p + 1)) (n : ℕ) :
  n ≤ ν → ‖MolecularDynamics.oneStepIterate G h (γ 0) n - γ (↑n * h)‖ ≤ K / L * Real.exp (L * (↑n * h)) * h ^ p
MolecularDynamics.oneStepMaxError_order_bound.{u_1} {E : Type u_1} [NormedAddCommGroup E] (G : ℝ → E → E) (γ : ℝ → E)
  (D : Set E) {h L K p τ : ℝ} (ν : ℕ) (hh : 0 < h) (hL : 0 < L) (hK : 0 ≤ K) (horizon : ↑ν * h ≤ τ)
  (hnum : ∀ n ≤ ν, MolecularDynamics.oneStepIterate G h (γ 0) n ∈ D) (hexact : ∀ n ≤ ν, γ (↑n * h) ∈ D)
  (hstable : ∀ u ∈ D, ∀ w ∈ D, ‖G h u - G h w‖ ≤ (1 + h * L) * ‖u - w‖)
  (hconsistent : ∀ n < ν, ‖G h (γ (↑n * h)) - γ (↑(n + 1) * h)‖ ≤ K * h ^ (p + 1)) :
