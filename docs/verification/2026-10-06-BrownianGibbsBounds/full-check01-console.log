  ∑ i, deriv (deriv fun t => MolecularDynamics.textbookLangevinHamiltonianPower U l (z + t • (0, Pi.single i 1))) 0 =
    ↑l * (↑l - 1) * MolecularDynamics.textbookLangevinHamiltonian U z ^ (l - 2) * ∑ i, z.2 i ^ 2 +
      ↑Nc * ↑l * MolecularDynamics.textbookLangevinHamiltonian U z ^ (l - 1)
MolecularDynamics.textbookLangevinHamiltonianPower_momentum_laplacian_bound {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ)
  (hU : ∀ (q : Fin Nc → ℝ), 1 ≤ U q) (l : ℕ) (hl : 1 ≤ l) (z : MolecularDynamics.textbookLangevinPhase Nc) :
  ∑ i, deriv (deriv fun t => MolecularDynamics.textbookLangevinHamiltonianPower U l (z + t • (0, Pi.single i 1))) 0 ≤
    (2 * ↑l * (↑l - 1) + ↑Nc * ↑l) * MolecularDynamics.textbookLangevinHamiltonian U z ^ (l - 1)
