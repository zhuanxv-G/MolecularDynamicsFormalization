MolecularDynamics.textbookLangevinHamiltonianPower_momentum_second {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ) (l : ℕ) (hl : 1 ≤ l)
  (z : MolecularDynamics.textbookLangevinPhase Nc) (i : Fin Nc) :
  deriv (deriv fun t => MolecularDynamics.textbookLangevinHamiltonianPower U l (z + t • (0, Pi.single i 1))) 0 =
    ↑l * (↑l - 1) * MolecularDynamics.textbookLangevinHamiltonian U z ^ (l - 2) * z.2 i ^ 2 +
      ↑l * MolecularDynamics.textbookLangevinHamiltonian U z ^ (l - 1)
