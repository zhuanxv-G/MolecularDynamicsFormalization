  Subgroup (Equiv.Perm (MolecularDynamics.SymplecticCoordinates Nc))
MolecularDynamics.textbookSymplecticDiffeomorphism_mul_apply {Nc : ℕ}
  (e f : ↥(MolecularDynamics.TextbookSymplecticDiffeomorphism Nc)) (z : MolecularDynamics.SymplecticCoordinates Nc) :
  ↑(e * f) z = ↑e (↑f z)
