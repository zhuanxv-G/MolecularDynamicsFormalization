  (P : { P // PowerSeries.constantCoeff P = 0 }) : PowerSeries R
MolecularDynamics.textbookFormalZeroConstantExponential_coeff_stabilizes.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R]
  (P : { P // PowerSeries.constantCoeff P = 0 }) (j N : ℕ) (hjN : j < N) :
  (PowerSeries.coeff j) (MolecularDynamics.textbookFormalZeroConstantExponential P) =
    ∑ n ∈ Finset.range N, (1 / ↑n.factorial) • (PowerSeries.coeff j) (↑P ^ n)
