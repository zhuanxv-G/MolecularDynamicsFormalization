  Equiv.Perm (MolecularDynamics.SymplecticCoordinates Nc)
MolecularDynamics.textbookPositionDriftEquiv {Nc : ℕ} (m : Fin Nc → ℝ) (h : ℝ) :
  Equiv.Perm (MolecularDynamics.SymplecticCoordinates Nc)
MolecularDynamics.textbookSymplecticEulerEquiv {Nc : ℕ} (m : Fin Nc → ℝ) (U : (Fin Nc → ℝ) → ℝ) (h : ℝ) :
  Equiv.Perm (MolecularDynamics.SymplecticCoordinates Nc)
MolecularDynamics.textbookSymplecticEulerEquiv_apply {Nc : ℕ} (m : Fin Nc → ℝ) (U : (Fin Nc → ℝ) → ℝ) (h : ℝ)
  (z : MolecularDynamics.SymplecticCoordinates Nc) :
  (MolecularDynamics.textbookSymplecticEulerEquiv m U h) z = MolecularDynamics.textbookSymplecticEuler m U h z
MolecularDynamics.textbookSymplecticEulerEquiv_symm_apply {Nc : ℕ} (m : Fin Nc → ℝ) (U : (Fin Nc → ℝ) → ℝ) (h : ℝ)
  (z : MolecularDynamics.SymplecticCoordinates Nc) :
  (Equiv.symm (MolecularDynamics.textbookSymplecticEulerEquiv m U h)) z =
    MolecularDynamics.textbookMomentumKick (MolecularDynamics.textbookPotentialForce U) (-h)
      (MolecularDynamics.textbookPositionDrift m (-h) z)
