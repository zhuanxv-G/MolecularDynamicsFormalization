  {P : MeasureTheory.Measure Ω} {W : NNReal → Ω → ℝ} (hW : ProbabilityTheory.IsPreBrownianReal W P) (T : NNReal) (K : ℕ)
  (a b : Fin K → ℝ) :
  ∫ (ω : Ω),
      (MolecularDynamics.textbookWienerWeightedSum W T K a ω - MolecularDynamics.textbookWienerWeightedSum W T K b ω) ^
        2 ∂P =
    ∑ k, (a k - b k) ^ 2 * (↑T / ↑↑K)
