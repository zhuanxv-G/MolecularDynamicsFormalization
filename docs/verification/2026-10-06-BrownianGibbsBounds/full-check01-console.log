MolecularDynamics.textbookFormalOperatorExponential.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R] (A : R) : PowerSeries R
MolecularDynamics.textbookFormalOperatorExponential_coeff.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R] (A : R) (n : ℕ) :
  (PowerSeries.coeff n) (MolecularDynamics.textbookFormalOperatorExponential A) = (1 / ↑n.factorial) • A ^ n
MolecularDynamics.textbookFormalOperatorProduct_coeff_zero.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R] (A B : R) :
  (PowerSeries.coeff 0)
      (MolecularDynamics.textbookFormalOperatorExponential A * MolecularDynamics.textbookFormalOperatorExponential B) =
    1
MolecularDynamics.textbookFormalOperatorProduct_coeff_one.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R] (A B : R) :
  (PowerSeries.coeff 1)
      (MolecularDynamics.textbookFormalOperatorExponential A * MolecularDynamics.textbookFormalOperatorExponential B) =
    A + B
MolecularDynamics.textbookFormalOperatorProduct_coeff_two.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R] (A B : R) :
  (PowerSeries.coeff 2)
      (MolecularDynamics.textbookFormalOperatorExponential A * MolecularDynamics.textbookFormalOperatorExponential B) =
    (1 / 2) • A ^ 2 + A * B + (1 / 2) • B ^ 2
MolecularDynamics.textbookFormalOperatorProduct_coeff_three.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R] (A B : R) :
  (PowerSeries.coeff 3)
      (MolecularDynamics.textbookFormalOperatorExponential A * MolecularDynamics.textbookFormalOperatorExponential B) =
    (1 / 6) • A ^ 3 + (1 / 2) • (A ^ 2 * B) + (1 / 2) • (A * B ^ 2) + (1 / 6) • B ^ 3
MolecularDynamics.textbookFormalOperatorDifference_coeff_two.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R] (A B : R) :
  (PowerSeries.coeff 2)
      (MolecularDynamics.textbookFormalOperatorExponential A * MolecularDynamics.textbookFormalOperatorExponential B -
        MolecularDynamics.textbookFormalOperatorExponential (A + B)) =
    (1 / 2) • (A * B - B * A)
MolecularDynamics.textbookFormalOperatorDifference_coeff_three.{u_1} {R : Type u_1} [Ring R] [Algebra ℝ R] (A B : R) :
  (PowerSeries.coeff 3)
      (MolecularDynamics.textbookFormalOperatorExponential A * MolecularDynamics.textbookFormalOperatorExponential B -
        MolecularDynamics.textbookFormalOperatorExponential (A + B)) =
    (1 / 6) • (2 • (A * B ^ 2) + 2 • (A ^ 2 * B) - B * A ^ 2 - B * A * B - B ^ 2 * A - A * B * A)
MolecularDynamics.textbookFormalZeroConstant_power_coeff_zero.{u_1} {R : Type u_1} [Ring R]
  (P : { P // PowerSeries.constantCoeff P = 0 }) (j n : ℕ) (hjn : j < n) : (PowerSeries.coeff j) (↑P ^ n) = 0
