  (γ : ℝ → E) (ν : ℕ) (B : ℝ) (hb : ∀ n ≤ ν, ‖MolecularDynamics.eulerIterate f h (γ 0) n - γ (↑n * h)‖ ≤ B) :
  MolecularDynamics.eulerMaxError f h γ ν ≤ B
MolecularDynamics.eulerStep_norm_sub_le.{u_1} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E] (f : E → E)
  {h L : ℝ} (hh : 0 ≤ h) (x y : E) (hf : ‖f x - f y‖ ≤ L * ‖x - y‖) :
  ‖MolecularDynamics.eulerStep f h x - MolecularDynamics.eulerStep f h y‖ ≤ (1 + h * L) * ‖x - y‖
MolecularDynamics.euler_localDefect_of_derivative_bound.{u_1} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E]
  (f : E → E) (γ : ℝ → E) {s t A : ℝ} (hst : s ≤ t)
  (hγ : ∀ u ∈ Set.Icc s t, HasDerivWithinAt γ (f (γ u)) (Set.Icc s t) u)
  (hf : ∀ u ∈ Set.Icc s t, ‖f (γ u) - f (γ s)‖ ≤ A * (t - s)) :
  ‖γ t - MolecularDynamics.eulerStep f (t - s) (γ s)‖ ≤ A * (t - s) ^ 2
MolecularDynamics.exists_euler_trajectory_bounds.{u_1} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [ProperSpace E] (D : Set E) (hD : IsOpen D) (f : E → E) (hf : ContDiffOn ℝ 1 f D) (γ : ℝ → E) (τ : ℝ)
  (hγD : Set.MapsTo γ (Set.Icc 0 τ) D) (hγ : ∀ t ∈ Set.Icc 0 τ, HasDerivWithinAt γ (f (γ t)) (Set.Icc 0 τ) t) :
  ∃ r L A,
    0 < r ∧
      0 < L ∧
        0 < A ∧
          (∀ t ∈ Set.Icc 0 τ, ∀ (x : E), ‖x - γ t‖ ≤ r → x ∈ D ∧ ‖f x - f (γ t)‖ ≤ L * ‖x - γ t‖) ∧
            ∀ (s t : ℝ), 0 ≤ s → s ≤ t → t ≤ τ → ‖γ t - MolecularDynamics.eulerStep f (t - s) (γ s)‖ ≤ A * (t - s) ^ 2
MolecularDynamics.euler_convergence_on_open.{u_1} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [ProperSpace E] (D : Set E) (hD : IsOpen D) (f : E → E) (hf : ContDiffOn ℝ 1 f D) (γ : ℝ → E) {τ : ℝ} (hτ : 0 < τ)
  (hγD : Set.MapsTo γ (Set.Icc 0 τ) D) (hγ : ∀ t ∈ Set.Icc 0 τ, HasDerivWithinAt γ (f (γ t)) (Set.Icc 0 τ) t) :
  ∃ C,
    0 < C ∧
      ∃ ν₀,
        0 < ν₀ ∧
          ∀ ν ≥ ν₀,
            ∀ n ≤ ν,
              MolecularDynamics.eulerIterate f (τ / ↑ν) (γ 0) n ∈ D ∧
                ‖MolecularDynamics.eulerIterate f (τ / ↑ν) (γ 0) n - γ (↑n * (τ / ↑ν))‖ ≤ C * (τ / ↑ν)
MolecularDynamics.theorem_2_1_euler {m : ℕ} (D : Set (MolecularDynamics.Position m))
  (_hDbounded : Bornology.IsBounded D) (hD : IsOpen D) (f : MolecularDynamics.Position m → MolecularDynamics.Position m)
  (hf : ContDiffOn ℝ 1 f D) (γ : ℝ → MolecularDynamics.Position m) {τ : ℝ} (hτ : 0 ≤ τ)
  (hγD : Set.MapsTo γ (Set.Icc 0 τ) D) (hγ : ∀ t ∈ Set.Icc 0 τ, HasDerivWithinAt γ (f (γ t)) (Set.Icc 0 τ) t) :
  ∃ C,
    0 < C ∧
      ∃ ν₀,
        0 < ν₀ ∧
          ∀ ν ≥ ν₀,
            (∀ n ≤ ν, MolecularDynamics.eulerIterate f (τ / ↑ν) (γ 0) n ∈ D) ∧
              MolecularDynamics.eulerMaxError f (τ / ↑ν) γ ν ≤ C * (τ / ↑ν)
