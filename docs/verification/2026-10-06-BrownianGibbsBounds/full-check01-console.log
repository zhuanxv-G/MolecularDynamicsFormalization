  (H : MolecularDynamics.SymplecticCoordinates Nc → ℝ) (z : ℝ → MolecularDynamics.SymplecticCoordinates Nc)
  (W : ℝ → MolecularDynamics.SymplecticCoordinateMatrix Nc) (τ : ℝ) (hH : ∀ t ∈ Set.Icc 0 τ, ContDiffAt ℝ 2 H (z t))
  (hW :
