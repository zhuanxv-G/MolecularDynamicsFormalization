  Equiv.Perm (MolecularDynamics.SymplecticCoordinates Nc)
MolecularDynamics.textbookAdjointSymplecticEuler_apply {Nc : ℕ} (m : Fin Nc → ℝ) (U : (Fin Nc → ℝ) → ℝ) (h : ℝ)
  (z : MolecularDynamics.SymplecticCoordinates Nc) :
  (MolecularDynamics.textbookAdjointSymplecticEuler m U h) z =
    MolecularDynamics.textbookMomentumKick (MolecularDynamics.textbookPotentialForce U) h
      (MolecularDynamics.textbookPositionDrift m h z)
MolecularDynamics.textbookAdjointSymplecticEuler_position {Nc : ℕ} (m : Fin Nc → ℝ) (U : (Fin Nc → ℝ) → ℝ) (h : ℝ)
  (z : MolecularDynamics.SymplecticCoordinates Nc) (i : Fin Nc) :
  (MolecularDynamics.textbookAdjointSymplecticEuler m U h) z (Sum.inl i) = z (Sum.inl i) + h * (m i)⁻¹ * z (Sum.inr i)
MolecularDynamics.textbookAdjointSymplecticEuler_momentum {Nc : ℕ} (m : Fin Nc → ℝ) (U : (Fin Nc → ℝ) → ℝ) (h : ℝ)
  (z : MolecularDynamics.SymplecticCoordinates Nc) (i : Fin Nc) :
  (MolecularDynamics.textbookAdjointSymplecticEuler m U h) z (Sum.inr i) =
    z (Sum.inr i) +
