  (H : MolecularDynamics.SymplecticCoordinates Nc → ℝ)
  (F : ℝ → MolecularDynamics.SymplecticCoordinates Nc → MolecularDynamics.SymplecticCoordinates Nc) (τ : ℝ)
  (hF : ∀ t ∈ Set.Icc 0 τ, ContDiff ℝ 1 (F t))
  (hH : ∀ t ∈ Set.Icc 0 τ, ∀ (z : MolecularDynamics.SymplecticCoordinates Nc), ContDiffAt ℝ 2 H (F t z))
