MolecularDynamics.oneStep_converges_of_consistency_stability.{u_1} {E : Type u_1} [NormedAddCommGroup E] (G : ℝ → E → E)
  (γ : ℝ → E) (D : Set E) {τ δ L K p : ℝ} (hτ : 0 < τ) (hδ : 0 < δ) (hL : 0 < L) (hK : 0 ≤ K) (hp : 0 < p)
  (hexact : Set.MapsTo γ (Set.Icc 0 τ) D)
  (hnum : ∀ (ν : ℕ), 0 < ν → τ / ↑ν ≤ δ → ∀ n ≤ ν, MolecularDynamics.oneStepIterate G (τ / ↑ν) (γ 0) n ∈ D)
  (hstable : ∀ h ∈ Set.Ioc 0 δ, ∀ u ∈ D, ∀ w ∈ D, ‖G h u - G h w‖ ≤ (1 + h * L) * ‖u - w‖)
  (hconsistent : ∀ h ∈ Set.Ioo 0 δ, ∀ t ∈ Set.Icc 0 τ, t + h ≤ τ → ‖G h (γ t) - γ (t + h)‖ ≤ K * h ^ (p + 1)) :
