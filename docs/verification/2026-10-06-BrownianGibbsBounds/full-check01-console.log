MolecularDynamics.textbookCanonicalDensityCutoff_flux_divergence {Nc : ℕ}
  (H : MolecularDynamics.SymplecticCoordinates Nc → ℝ)
  (G : MolecularDynamics.SymplecticCoordinates Nc → MolecularDynamics.SymplecticCoordinates Nc) (β R : ℝ)
  (z : MolecularDynamics.SymplecticCoordinates Nc) (hH : DifferentiableAt ℝ H z) (hG : DifferentiableAt ℝ G z) :
  MolecularDynamics.textbookDivergence
      (fun x =>
        MolecularDynamics.textbookCanonicalDensityCutoff H β R x •
          MolecularDynamics.textbookHamiltonianGibbsWeight H β x • G x)
      z =
    MolecularDynamics.textbookCanonicalDensityCutoff H β R z *
        MolecularDynamics.textbookDivergence (fun x => MolecularDynamics.textbookHamiltonianGibbsWeight H β x • G x) z -
      β / R * deriv Real.smoothTransition (2 - β * H z / R) *
        (MolecularDynamics.textbookLieDerivative G H z * MolecularDynamics.textbookHamiltonianGibbsWeight H β z)
