  (z : MolecularDynamics.SymplecticCoordinates Nc) : MolecularDynamics.SymplecticCoordinateMatrix Nc
MolecularDynamics.textbookHamiltonianHessian_isSymm {Nc : ℕ} (H : MolecularDynamics.SymplecticCoordinates Nc → ℝ)
  (z : MolecularDynamics.SymplecticCoordinates Nc) (hH : ContDiffAt ℝ 2 H z) :
  Matrix.IsSymm (MolecularDynamics.textbookHamiltonianHessian H z)
MolecularDynamics.hamiltonian_variational_matrix_cancellation {Nc : ℕ}
  (S W : MolecularDynamics.SymplecticCoordinateMatrix Nc) (hS : Matrix.IsSymm S) :
  (MolecularDynamics.textbookJ Nc * S * W).transpose * MolecularDynamics.textbookJ Nc * W +
      Matrix.transpose W * MolecularDynamics.textbookJ Nc * (MolecularDynamics.textbookJ Nc * S * W) =
    0
MolecularDynamics.hasDerivWithinAt_hamiltonian_variational_form {Nc : ℕ}
  (S W : ℝ → MolecularDynamics.SymplecticCoordinateMatrix Nc) (s : Set ℝ) (t : ℝ) (hS : Matrix.IsSymm (S t))
  (hW : HasDerivWithinAt W (MolecularDynamics.textbookJ Nc * S t * W t) s t) :
  HasDerivWithinAt (fun u => Matrix.transpose (W u) * MolecularDynamics.textbookJ Nc * W u) 0 s t
MolecularDynamics.hamiltonian_variational_form_constant {Nc : ℕ}
  (S W : ℝ → MolecularDynamics.SymplecticCoordinateMatrix Nc) (τ : ℝ) (hS : ∀ t ∈ Set.Icc 0 τ, Matrix.IsSymm (S t))
  (hW : ∀ t ∈ Set.Icc 0 τ, HasDerivWithinAt W (MolecularDynamics.textbookJ Nc * S t * W t) (Set.Icc 0 τ) t) (t : ℝ) :
  t ∈ Set.Icc 0 τ →
    Matrix.transpose (W t) * MolecularDynamics.textbookJ Nc * W t =
      Matrix.transpose (W 0) * MolecularDynamics.textbookJ Nc * W 0
MolecularDynamics.hamiltonian_variational_isSymplectic {Nc : ℕ}
  (S W : ℝ → MolecularDynamics.SymplecticCoordinateMatrix Nc) (τ : ℝ) (hS : ∀ t ∈ Set.Icc 0 τ, Matrix.IsSymm (S t))
  (hW : ∀ t ∈ Set.Icc 0 τ, HasDerivWithinAt W (MolecularDynamics.textbookJ Nc * S t * W t) (Set.Icc 0 τ) t)
  (hinit : W 0 = 1) (t : ℝ) : t ∈ Set.Icc 0 τ → MolecularDynamics.IsTextbookSymplectic (W t)
