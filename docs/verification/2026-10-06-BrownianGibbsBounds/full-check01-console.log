  (hA : A.IsHermitian) (k : ℕ) (v : Fin Nc → ℝ) (i : Fin Nc) :
  (MolecularDynamics.textbookThermostatEigenCoordinates hA) ((A ^ k).mulVec v) i =
    hA.eigenvalues i ^ k * (MolecularDynamics.textbookThermostatEigenCoordinates hA) v i
