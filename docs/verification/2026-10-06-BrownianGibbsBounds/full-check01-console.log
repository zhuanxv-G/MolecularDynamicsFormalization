  (z : MolecularDynamics.SymplecticCoordinates Nc) :
  MolecularDynamics.textbookJacobian (⇑(Equiv.symm e)) z =
    (MolecularDynamics.textbookJacobian (⇑e) ((Equiv.symm e) z))⁻¹
