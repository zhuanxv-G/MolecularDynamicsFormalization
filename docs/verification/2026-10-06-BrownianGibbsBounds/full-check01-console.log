  (f g : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U) (hf : ContDiff ℝ (↑⊤) f) (hg : ContDiff ℝ (↑⊤) g) (i : Fin Nc)
  (q : Fin Nc → ℝ) :
  MolecularDynamics.textbookConfigurationPartial (MolecularDynamics.textbookBrownianWeightedFlux m U β f g i) i q =
