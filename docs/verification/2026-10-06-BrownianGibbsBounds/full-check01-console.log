  (z : MolecularDynamics.SymplecticCoordinates Nc) :
  MolecularDynamics.textbookPoissonBracket F G z =
    ∑ i,
      ((fderiv ℝ F z) (Pi.single (Sum.inl i) 1) * (fderiv ℝ G z) (Pi.single (Sum.inr i) 1) -
