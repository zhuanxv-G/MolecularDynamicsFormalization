  (hU : Differentiable ℝ U) (γ : ℝ) (l : ℕ) (z : MolecularDynamics.textbookLangevinPhase Nc) :
  HasDerivAt
    (fun t =>
      MolecularDynamics.textbookLangevinHamiltonianPower U l (z + t • MolecularDynamics.textbookLangevinDrift U γ z))
    (-γ * ↑l * MolecularDynamics.textbookLangevinHamiltonian U z ^ (l - 1) * ∑ i, z.2 i ^ 2) 0
MolecularDynamics.textbookLangevinHamiltonianPower_differentialOperator {Nc : ℕ} (U : (Fin Nc → ℝ) → ℝ)
  (hU : Differentiable ℝ U) (γ σ : ℝ) (l : ℕ) (hl : 1 ≤ l) (z : MolecularDynamics.textbookLangevinPhase Nc) :
