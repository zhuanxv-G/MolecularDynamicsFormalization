  (MolecularDynamics.textbookThermostatSpectralPhase hA) ((MolecularDynamics.textbookThermostatC A k) z) =
    (fun i => hA.eigenvalues i ^ k * (MolecularDynamics.textbookThermostatEigenCoordinates hA) z.2 i, fun i =>
      hA.eigenvalues i ^ (k + 1) * (MolecularDynamics.textbookThermostatEigenCoordinates hA) z.1 i)
MolecularDynamics.textbookThermostat_D_coordinates {Nc : ℕ} {A : Matrix (Fin Nc) (Fin Nc) ℝ} (hA : A.IsHermitian)
