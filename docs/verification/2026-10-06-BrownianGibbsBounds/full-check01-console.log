  (MolecularDynamics.textbookThermostatSpectralPhase hA) ((MolecularDynamics.textbookThermostatD A k) z) =
    (fun i => hA.eigenvalues i ^ (k + 1) * (MolecularDynamics.textbookThermostatEigenCoordinates hA) z.1 i, fun i =>
