MolecularDynamics.textbookWienerSelfItoSum_identity.{u_1} {Ω : Type u_1} [MeasurableSpace Ω]
  {P : MeasureTheory.Measure Ω} {W : NNReal → Ω → ℝ} (hW : ProbabilityTheory.IsPreBrownianReal W P) (T : NNReal) {K : ℕ}
  (hK : 0 < K) :
  ∀ᵐ (ω : Ω) ∂P,
    2 * MolecularDynamics.textbookWienerSelfItoSum W T K ω =
      W T ω ^ 2 - MolecularDynamics.textbookWienerQuadraticSum W T K ω
