Set.Finite.compl_mem_cofinite.{u_2} {α : Type u_2} {s : Set α} (hs : s.Finite) : sᶜ ∈ Filter.cofinite
Metric.tendsto_nhds.{u, v} {α : Type u} {β : Type v} [PseudoMetricSpace α] {f : Filter β} {u : β → α} {a : α} :
  Filter.Tendsto u f (nhds a) ↔ ∀ ε > 0, ∀ᶠ (x : β) in f, dist (u x) a < ε
