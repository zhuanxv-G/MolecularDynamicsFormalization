lp.norm_rpow_eq_tsum.{u_3, u_4} {α : Type u_3} {E : α → Type u_4} {p : ENNReal} [(i : α) → NormedAddCommGroup (E i)]
  (hp : 0 < p.toReal) (f : ↥(lp E p)) : ‖f‖ ^ p.toReal = ∑' (i : α), ‖↑f i‖ ^ p.toReal
tendsto_tsum_of_dominated_convergence.{u_1, u_2, u_3} {α : Type u_1} {β : Type u_2} {G : Type u_3} {𝓕 : Filter α}
  [NormedAddCommGroup G] [CompleteSpace G] {f : α → β → G} {g : β → G} {bound : β → ℝ} (h_sum : Summable bound)
  (hab : ∀ (k : β), Filter.Tendsto (fun x => f x k) 𝓕 (nhds (g k)))
  (h_bound : ∀ᶠ (n : α) in 𝓕, ∀ (k : β), ‖f n k‖ ≤ bound k) :
  Filter.Tendsto (fun x => ∑' (k : β), f x k) 𝓕 (nhds (∑' (k : β), g k))
