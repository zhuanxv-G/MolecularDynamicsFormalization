MolecularDynamics.textbookBrownianGibbsResolvent_coefficient {Nc : ℕ} (m : Fin Nc → ℝ) (hm : ∀ (i : Fin Nc), 0 < m i)
  (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U) (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ)
  (hβ : 0 < β) (x : ↥(MolecularDynamics.Gibbs✝ U β))
  (j : MolecularDynamics.textbookBrownianGibbsEigenIndex m U hU hPU β) :
  inner ℝ ((MolecularDynamics.textbookBrownianGibbsEigenbasis m hm U hU hPU β hβ) j)
      ((MolecularDynamics.textbookBrownianGibbsResolvent m U hU hPU β hm hβ) x) =
    (1 - j.fst)⁻¹ * inner ℝ ((MolecularDynamics.textbookBrownianGibbsEigenbasis m hm U hU hPU β hβ) j) x
MolecularDynamics.textbookBrownianGibbsResolvent_isCompact {Nc : ℕ} (m : Fin Nc → ℝ) (U : (Fin Nc → ℝ) → ℝ)
  (hU : ContDiff ℝ (↑⊤) U) (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ)
  (hm : ∀ (i : Fin Nc), 0 < m i) (hβ : 0 < β) :
  IsCompactOperator ⇑(MolecularDynamics.textbookBrownianGibbsResolvent m U hU hPU β hm hβ)
MolecularDynamics.textbookBrownianGibbsComplexEigenbasis_coefficient_re_im {Nc : ℕ} (m : Fin Nc → ℝ)
  (hm : ∀ (i : Fin Nc), 0 < m i) (U : (Fin Nc → ℝ) → ℝ) (hU : ContDiff ℝ (↑⊤) U)
  (hPU : MolecularDynamics.textbookUnitPeriodicPotential U) (β : ℝ) (hβ : 0 < β)
  (j : MolecularDynamics.textbookBrownianGibbsEigenIndex m U hU hPU β) (z : ↥(MolecularDynamics.GibbsComplex✝ U β)) :
  inner ℂ ((MolecularDynamics.cb✝ m hm U hU hPU β hβ) j) z =
    ↑(inner ℝ ((MolecularDynamics.rb✝ m hm U hU hPU β hβ) j)
          ((MolecularDynamics.textbookBrownianGibbsL2RealPart U β) z)) +
      Complex.I *
        ↑(inner ℝ ((MolecularDynamics.rb✝ m hm U hU hPU β hβ) j)
            ((MolecularDynamics.textbookBrownianGibbsL2ImagPart U β) z))
inv_mul_cancel₀.{u_3} {G₀ : Type u_3} [GroupWithZero G₀] {a : G₀} (h : a ≠ 0) : a⁻¹ * a = 1
