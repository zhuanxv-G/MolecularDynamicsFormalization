  (hf : HasSum f a L) (hg : HasSum g b L) : HasSum (fun x => (f x, g x)) (a, b) L
IsClosed.mem_of_tendsto.{u, u_1} {X : Type u} [TopologicalSpace X] {α : Type u_1} {x : X} {s : Set X} {f : α → X}
  {b : Filter α} [b.NeBot] (hs : IsClosed s) (hf : Filter.Tendsto f b (nhds x)) (h : ∀ᶠ (x : α) in b, f x ∈ s) : x ∈ s
