def MolecularDynamics.matrixKineticGoal : {n : ℕ} → CoordinateMasses n → Momentum n → Prop :=
fun {n} m p => (∀ (i : Fin n), 0 < m i) → momentumKineticEnergy m p = ⟪p, (velocityOperator m) p⟫_ℝ / 2
def MolecularDynamics.velocityEnergyGoal : {n : ℕ} →
  CoordinateMasses n → PotentialEnergy n → Position n → Velocity n → Prop :=
fun {n} m U q v => massHamiltonian m U (q, (massOperator m) v) = nBodyTotalEnergy m U q v
def MolecularDynamics.particleEnergyGoal : {N d : ℕ} →
  ParticleMasses N → PotentialEnergy (N * d) → ParticleVectors N d → ParticleVectors N d → Prop :=
fun {N d} m U q v =>
  massHamiltonian (coordinateMassesOfParticles m) U
      (flattenParticleVectors q, (massOperator (coordinateMassesOfParticles m)) (flattenParticleVectors v)) =
    particleKineticEnergy m v + U (flattenParticleVectors q)
def MolecularDynamics.coordinateGradientGoal : {n : ℕ} → CoordinateMasses n → Momentum n → Prop :=
fun {n} m p => HasGradientAt (momentumKineticEnergy m) (coordinateVelocity m p) p
def MolecularDynamics.matrixGradientGoal : {n : ℕ} → CoordinateMasses n → Momentum n → Prop :=
fun {n} m p => (∀ (i : Fin n), 0 < m i) → gradient (momentumKineticEnergy m) p = (velocityOperator m) p
def MolecularDynamics.positionGradientGoal : {n : ℕ} →
  CoordinateMasses n → PotentialEnergy n → Position n → Momentum n → Prop :=
fun {n} m U q p => DifferentiableAt ℝ U q → HasGradientAt (fun x => massHamiltonian m U (x, p)) (gradient U q) q
def MolecularDynamics.positionTotalGradientGoal : {n : ℕ} →
  CoordinateMasses n → PotentialEnergy n → Position n → Momentum n → Prop :=
fun {n} m U q p => gradient (fun x => massHamiltonian m U (x, p)) q = gradient U q
def MolecularDynamics.vectorFieldGoal : {n : ℕ} → CoordinateMasses n → PotentialEnergy n → PhaseSpace n → Prop :=
fun {n} m U z => (∀ (i : Fin n), 0 < m i) → hamiltonianVectorField m U z = ((velocityOperator m) z.2, -gradient U z.1)
def MolecularDynamics.inverseEnergyGoal : {n : ℕ} →
  CoordinateMasses n → PotentialEnergy n → Position n → Momentum n → Prop :=
fun {n} m U q p =>
  (∀ (i : Fin n), 0 < m i) → massHamiltonian m U (q, p) = nBodyTotalEnergy m U q ((velocityOperator m) p)
'MolecularDynamics.prove_matrixKineticGoal' depends on axioms: [propext, Classical.choice, Quot.sound]
'MolecularDynamics.prove_velocityEnergyGoal' depends on axioms: [propext, Classical.choice, Quot.sound]
'MolecularDynamics.prove_particleEnergyGoal' depends on axioms: [propext, Classical.choice, Quot.sound]
'MolecularDynamics.prove_coordinateGradientGoal' depends on axioms: [propext, Classical.choice, Quot.sound]
'MolecularDynamics.prove_matrixGradientGoal' depends on axioms: [propext, Classical.choice, Quot.sound]
'MolecularDynamics.prove_positionGradientGoal' depends on axioms: [propext, Classical.choice, Quot.sound]
'MolecularDynamics.prove_positionTotalGradientGoal' depends on axioms: [propext, Classical.choice, Quot.sound]
'MolecularDynamics.prove_vectorFieldGoal' depends on axioms: [propext, Classical.choice, Quot.sound]
'MolecularDynamics.prove_inverseEnergyGoal' depends on axioms: [propext, Classical.choice, Quot.sound]
